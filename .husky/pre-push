echo ""
echo "🔍 Running pre-push quality checks..."
echo ""

# Get current branch name
BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "📍 Current branch: $BRANCH"
echo ""

# Always run these checks (existing behavior)
echo "▶️  TypeScript validation..."
npm run type-check || {
  echo ""
  echo "❌ TypeScript check failed"
  echo ""
  exit 1
}

# Lint + custom platform checks. Matches what CI's Quality Checks job runs.
# Covers:
#   - per-package ESLint (incl. site-level rules like platform/no-hardcoded-tailwind-colors)
#   - scripts/check-token-usage.ts (composable hex / "use client" / default-export / inline-style gates)
# Fast path: if EVERY file being pushed is docs/content/output, skip lint to
# keep push snappy on content-only work. Anything we can't confidently classify
# as docs defaults to running lint.
SKIP_LINT=0
if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); then
  CHANGED_CODE=$(git diff --name-only "$UPSTREAM" HEAD 2>/dev/null)
  if [ -n "$CHANGED_CODE" ]; then
    # Any file NOT in docs/output/*.md(x) → run lint
    CODE_FILES=$(echo "$CHANGED_CODE" | grep -Ev '^(output/|docs/).*' | grep -Ev '\.(md|mdx)$' | head -1)
    [ -z "$CODE_FILES" ] && SKIP_LINT=1
  fi
fi

if [ "$SKIP_LINT" = "1" ]; then
  echo ""
  echo "▶️  Skipping lint (only docs/content/output changed in this push)..."
else
  echo ""
  echo "▶️  Lint (eslint + platform quality gates)..."
  npm run lint || {
    echo ""
    echo "❌ Lint failed — fix the errors above and push again."
    echo ""
    echo "💡 Tip: run \`npm run lint\` locally at any time to re-check."
    echo ""
    exit 1
  }
fi

# Branch-specific quality gates
if [ "$BRANCH" = "main" ]; then
  # For main: verify the EXACT commit being promoted passed staging E2E.
  # This uses the shared, fail-closed verifier (scripts/verify-staging-e2e.ts)
  # so the local hook matches the server-side gate in deploy.yml. It no longer
  # (F8) fails open when gh is missing, nor (F9) accepts the latest staging run
  # regardless of which commit it tested — the verifier fails closed on both.
  echo ""
  echo "🔍 Verifying staging E2E passed for the commit being promoted..."
  echo ""

  # Resolve the promoted staging tip: HEAD^2 if HEAD is a merge commit, else HEAD.
  PROMOTED_SHA=$(git rev-parse HEAD)
  if git rev-parse HEAD^2 >/dev/null 2>&1; then
    PROMOTED_SHA=$(git rev-parse HEAD^2)
  fi

  if npx tsx scripts/verify-staging-e2e.ts --sha="$PROMOTED_SHA"; then
    echo "✅ Staging E2E verified for $PROMOTED_SHA — safe to deploy to main"
  else
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ STAGING E2E NOT VERIFIED FOR THE PROMOTED COMMIT"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Staging is the final quality gate before main, and this gate fails closed:"
    echo "if it cannot PROVE the promoted commit is green on staging, it blocks."
    echo ""
    echo "🔧 Required steps:"
    echo "  1. Ensure the commit you're promoting is merged to staging"
    echo "  2. Wait for its 'E2E Tests' run on staging to conclude green"
    echo "  3. Ensure gh is authenticated (gh auth status) or GITHUB_TOKEN is set"
    echo "  4. Then push to main"
    echo ""
    exit 1
  fi

elif [ "$BRANCH" = "develop" ] || [ "$BRANCH" = "staging" ]; then
  # For develop/staging: Smoke tests run in CI, not locally
  echo ""
  echo "🧹 Cleaning build cache to prevent corruption..."
  echo ""

  # Clean .next directories to prevent corrupted build cache issues
  # This prevents 404/500 errors during smoke tests caused by stale webpack chunks
  find sites -name ".next" -type d -exec rm -rf {} + 2>/dev/null || true

  echo ""
  echo "ℹ️  Smoke tests will run in CI (GitHub Actions) for $BRANCH"
  echo "   Skipping local smoke tests for faster push"
  echo ""
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ All pre-push checks passed!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""