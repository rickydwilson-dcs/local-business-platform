  "cssOverrides": "/* Design Lab Eastbourne — site-specific overrides */\n\n:root {\n  --site-section-padding-y: 4rem;\n  --site-container-max-width: 80rem;\n}\n\n@media (min-width: 768px) {\n  :root {\n    --site-section-padding-y: 6rem;\n  }\n}\n\nbody {\n  background-color: var(--color-surface-background);\n  color: var(--color-surface-foreground);\n  font-family: var(--font-sans);\n}\n\n.btn-primary {\n  background-color: var(--color-brand-primary);\n  color: var(--color-brand-on-primary);\n  border-radius: var(--radius-button);\n  font-weight: 700;\n}\n\n.btn-primary:hover {\n  background-color: var(--color-brand-primary-hover);\n}\n\n.btn-outline-white {\n  background-color: transparent;\n  color: var(--color-brand-on-primary);\n  border: 2px solid var(--color-brand-on-primary);\n  border-radius: var(--radius-button);\n  font-weight: 700;\n}\n\n.cta-banner {\n  background-color: var(--color-brand-primary);\n  color: var(--color-brand-on-primary);\n}\n\n.site-nav {\n  background-color: var(--color-surface-background);\n  color: var(--color-surface-foreground);\n}\n\n.site-footer {\n  background-color: var(--color-surface-inverse);\n  color: var(--color-surface-foreground);\n}\n\n.site-footer a {\n  color: var(--color-brand-primary);\n}\n\n.text-brand {\n  color: var(--color-brand-primary);\n}\n\n.card {\n  background-color: var(--color-surface-card);\n  border-color: var(--color-surface-card-border);\n  border-radius: var(--radius-card);\n}\n\n.section {\n  padding-top: var(--site-section-padding-y);\n  padding-bottom: var(--site-section-padding-y);\n}\n\n.hero-split {\n  background-color: var(--color-surface-background);\n  color: var(--color-surface-foreground);\n}\n\n.hero-split .hero-image-frame {\n  border: 2px solid var(--color-brand-primary);\n}\n\n.eyebrow-label {\n  color: var(--color-brand-primary);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n}\n\n.muted-text {\n  color: var(--color-surface-secondary-foreground);\n}\n",
