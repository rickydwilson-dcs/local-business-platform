/* ==========================================================================
   DCS r9 — kit.css
   The shared stylesheet for every DCS inner-page prototype.

   PROVENANCE. Every rule below is copied from one of three files, and the
   source line is named in the comment above it:

     home-r9.css   sites/dcs/styles/home-r9.css              (721 lines)
     reset.css     sites/dcs/styles/home-r9-reset.css        (88 lines)
     shared.css    output/sessions/2026-08/2026-08-26_dcs-projects-pages/
                   prototype/shared.css                      (169 lines)

   Nothing here was typed from memory or approximated. Where home-r9.css and
   shared.css disagree, the choice and the reason are recorded in
   design-kit.md §11.2 — not decided silently here.

   NO NEW COMPONENTS. There is no breadcrumb, no page masthead, no page-level
   footer and no form styling in this file, because none exists yet. Those are
   Tier 0 and belong to Phase 2. See design-kit.md §13 for the full gap list.

   USAGE. The prototype HTML must load the fonts with a real <link>, never a
   CSS @import (Tailwind buries an @import mid-file and the browser silently
   ignores it per spec). Exactly as project-list.html:7-9 does:

     <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
     <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Poppins:wght@300&display=swap" rel="stylesheet">
     <link rel="stylesheet" href="kit.css">

   CONTENTS
     01  tokens
     02  reset + base
     03  type
     04  bar / mark / burger / nav / hire
     05  menu overlay
     06  buttons
     07  panels, grounds, cornerfill
     08  section shells
     09  cards
     10  slot (awaiting footage)
     11  mock (drawn browser)
     12  row list (light ground)
     13  svc list (dark ground)
     14  svccard stack
     15  wpanel stack (full-bleed video)
     16  steps
     17  pricing
     18  questions (accordion)
     19  quote
     20  end / big
     21  filter + empty state
     22  responsive
     23  motion
     24  touch (hover:none)
   ========================================================================== */


/* ==========================================================================
   01  TOKENS
   Hexes are theme.config.ts:41-47 (colors.custom). Written literally rather
   than as var(--color-*) because a static prototype has no theme system —
   this is shared.css:8-15's call and it is correct.
   --f / --f-logo: home-r9.css:19-20, with the next/font variable replaced by
   the literal family name (shared.css:11-12).
   --pad / --r: home-r9.css:21-22, verbatim.
   ========================================================================== */
:root{
  --ink:#0E0E12; --paper:#ECEBE9; --white:#ffffff;
  --magenta:#D6006B; --aqua:#00D2D8; --navy:#17265E; --grey:#70707B;
  --f: 'Archivo', system-ui, -apple-system, sans-serif;
  --f-logo: 'Poppins', var(--f);
  --pad:clamp(20px,4.4vw,76px);
  --r:clamp(20px,3vw,44px);
}


/* ==========================================================================
   02  RESET + BASE
   home-r9.css:24,29-37 verbatim, plus shared.css:23 (img/video), which is a
   real omission in home-r9.css — that page never has a bare image.

   Do NOT add a Preflight-style normalise on top of this. Preflight's
   html{line-height:1.5} inherits everywhere this design leaves line-height
   alone and inflated .tiers by 66px / .steps by 46px / .tier__f by 15px on
   the real site (reset.css:16-21).

   scroll-padding-top:0 is load-bearing, not an omission: 84px landed a
   jumped-to section's top below the nav ground probe (home-r9.css:25-28).
   ========================================================================== */
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;overflow-x:clip;scroll-behavior:smooth;scroll-padding-top:0}
body{background:var(--paper);color:var(--ink);font-family:var(--f);font-weight:400;
  -webkit-font-smoothing:antialiased}
::selection{background:var(--magenta);color:#fff}
:focus-visible{outline:3px solid var(--magenta);outline-offset:4px;border-radius:2px}
a{color:inherit;text-decoration:none}
img,video{max-width:100%;display:block}
html::-webkit-scrollbar{width:9px}
html::-webkit-scrollbar-track{background:var(--paper)}
html::-webkit-scrollbar-thumb{background:var(--ink)}


/* ==========================================================================
   03  TYPE
   One family at every size — home-r9.css:5. Poppins 300 is LOGO ONLY
   (.mark__type, §04). Archivo 900 is registered but unused; the display
   weight of this design is 800.

   Headings here are shared.css:71-75's inner-page scale, NOT home-r9.css's
   homepage scale — an inner-page masthead at 8.8rem out-shouts the homepage.
   The homepage sizes are still available, scoped, at the bottom of this block.
   Reasoning: design-kit.md §11.2.
   ========================================================================== */

/* shared.css:71 */
h1{font-weight:800;letter-spacing:-.038em;line-height:1.02;font-size:clamp(2.3rem,7vw,6.4rem)}
/* shared.css:72 */
h2{font-weight:800;letter-spacing:-.034em;line-height:.94;font-size:clamp(2rem,5vw,4.2rem)}
/* shared.css:73 — home-r9.css has no global h3 rule at all; it styles h3 only
   through component classes (.wpanel__n, .svccard__t). Inner pages need one. */
h3{font-weight:800;letter-spacing:-.03em;line-height:1.02;font-size:clamp(1.5rem,2.6vw,2.2rem)}

/* shared.css:74 — home-r9.css:156 is opacity:.55 / margin-bottom:26px, which
   is homepage-panel spacing. 16px is right above a masthead h1. */
.eyeless{font-size:12.5px;letter-spacing:.11em;text-transform:uppercase;font-weight:700;
  opacity:.6;margin-bottom:16px}

/* shared.css:75 — home-r9.css:155 is mt 22px / 52ch / 1.28vw / lh 1.5 / op .94.
   Longer measure and looser leading for pages that are read, not scrolled past. */
.lead{margin-top:18px;max-width:56ch;font-size:clamp(1rem,1.22vw,1.16rem);line-height:1.55;opacity:.92}

/* home-r9.css:112-113,154 — the homepage display scale, kept available for a
   page that genuinely wants hero weight. Scoped so it is opt-in. */
.hero h1,.stack h1{font-size:clamp(2.3rem,8.9vw,8.8rem);letter-spacing:-.038em;line-height:1.02}
.stack h2{font-size:clamp(2.2rem,6.6vw,6.2rem);letter-spacing:-.034em;line-height:.9;max-width:17ch}

/* home-r9.css:117-118 — the magenta highlight block behind a headline word.
   Em-based, so it scales with the type it sits in. NOTE (hero.tsx:23-28): if
   a headline is split per character, .plate must be excluded from the split. */
.plate{display:inline-block;background:var(--magenta);color:#fff;
  padding:0 .1em .04em;margin-right:.06em;transform-origin:0 50%}

/* home-r9.css:114-116 — hero headline line/character/dim spans. */
h1 .ln{display:block}
h1 .ch{display:inline-block;white-space:pre}
h1 .dim{color:rgba(255,255,255,.44)}

/* home-r9.css:159-162 — the scroll-resolve heading treatment. THE SIGNATURE
   TYPOGRAPHIC BEHAVIOUR of this design: a .res heading renders in a muted rest
   colour and resolves to full currentColor over 1s when its panel gets `.in`.

   REQUIRES the .in latch. Without JS, a .res heading stays muted forever. The
   latch on the real site is (home-behaviour.tsx:276-289):

     new IntersectionObserver((es)=>{for(const e of es) if(e.isIntersecting){
       e.target.classList.add('in'); io.unobserve(e.target);}},{threshold:0.16})

   One-shot: once latched it is never removed, so a heading cannot flicker back.

   The rest colour must be legible UNAIDED — any headless render (Lighthouse
   included) catches the heading before the observer fires, at any viewport
   width (home-r9.css:628-632). That is why these values are not faint. */
.res{color:var(--grey);transition:color 1s cubic-bezier(.16,1,.3,1)}
.p--ink .res,.p--magenta .res,.p--navy .res{color:rgba(255,255,255,.72)}
.p--aqua .res{color:rgba(14,14,18,.66)}
.in .res{color:currentColor}


/* ==========================================================================
   04  BAR / MARK / BURGER / NAV / HIRE
   home-r9.css:42-104 verbatim, plus two rules shared.css supplied that
   home-r9.css genuinely lacks:
     - .bar nav{}        the flex container (shared.css:46). home-r9.css styles
                         `.bar nav a` at 89-95 but site-bar.tsx renders no
                         <nav> at all, so there was never a container rule.
     - [aria-current]    the active state (shared.css:52).
   Designing the actual inner-page nav is Phase 2 (design-kit.md G1).

   ONE ATTRIBUTE, data-ground, drives background, foreground, rule, accent and
   CTA foreground together. THE ACCENT RULE: aqua on ink/magenta/navy, magenta
   on paper/white/aqua. This generalises beyond the bar — use it anywhere an
   accent lands on an unusual ground.
   ========================================================================== */
.bar{position:fixed;top:0;left:0;right:0;z-index:70;
  display:flex;align-items:center;justify-content:space-between;gap:22px;
  padding:clamp(11px,1.5vw,17px) var(--pad);
  background:var(--bar-bg);color:var(--bar-fg);
  border-bottom:1px solid var(--bar-rule);
  transition:background-color .55s cubic-bezier(.4,0,.2,1),
             color .55s cubic-bezier(.4,0,.2,1),
             border-color .55s cubic-bezier(.4,0,.2,1)}
.bar[data-ground="paper"]  {--bar-bg:var(--paper); --bar-fg:var(--ink); --bar-rule:rgba(14,14,18,.16); --bar-acc:var(--magenta); --bar-cta-fg:#fff}
.bar[data-ground="white"]  {--bar-bg:var(--white); --bar-fg:var(--ink); --bar-rule:rgba(14,14,18,.14); --bar-acc:var(--magenta); --bar-cta-fg:#fff}
.bar[data-ground="ink"]    {--bar-bg:var(--ink);   --bar-fg:#fff;       --bar-rule:rgba(255,255,255,.22); --bar-acc:var(--aqua); --bar-cta-fg:var(--ink)}
.bar[data-ground="magenta"]{--bar-bg:var(--magenta);--bar-fg:#fff;      --bar-rule:rgba(255,255,255,.34); --bar-acc:var(--aqua); --bar-cta-fg:var(--ink)}
.bar[data-ground="aqua"]   {--bar-bg:var(--aqua);  --bar-fg:var(--ink); --bar-rule:rgba(14,14,18,.28);    --bar-acc:var(--magenta); --bar-cta-fg:#fff}
.bar[data-ground="navy"]   {--bar-bg:var(--navy);  --bar-fg:#fff;       --bar-rule:rgba(255,255,255,.28); --bar-acc:var(--aqua); --bar-cta-fg:var(--ink)}
.bar :focus-visible{outline-color:var(--bar-acc)}

/* home-r9.css:58-64 — logo lockup. .mark__type is the ONLY Poppins 300 on the
   site. Nothing else may use that face. */
.mark{display:flex;align-items:center;gap:clamp(10px,1vw,14px);color:inherit;flex:none}
.mark__svg{height:clamp(26px,2.4vw,33px);width:auto;display:block;flex:none}
.mark__type{font-family:var(--f-logo);font-weight:300;text-transform:lowercase;
  font-size:clamp(11.5px,1.02vw,13.5px);line-height:1.18;letter-spacing:.004em;white-space:nowrap;
  padding-left:clamp(10px,1vw,14px);border-left:1px solid currentColor;
  opacity:.92;transition:border-color .55s cubic-bezier(.4,0,.2,1)}
.mark__type span{display:block}

/* home-r9.css:66 */
.bar__r{margin-left:auto;display:flex;align-items:center;gap:clamp(8px,1vw,13px)}

/* home-r9.css:67-75 — two bars, not three (site-bar.tsx:78-79). Adding a
   middle bar would need a rule to hide it on open. */
.burger{width:clamp(40px,3.4vw,46px);height:clamp(40px,3.4vw,46px);border-radius:50%;
  border:1.4px solid currentColor;background:none;color:inherit;cursor:pointer;
  display:grid;align-content:center;justify-items:center;gap:5px;padding:0;
  transition:background-color .35s ease,color .35s ease}
.burger span{display:block;width:16px;height:1.6px;background:currentColor;
  transition:transform .4s cubic-bezier(.16,1,.3,1),opacity .25s ease}
.burger:hover{background:var(--bar-acc);color:var(--bar-cta-fg)}
.burger[aria-expanded="true"] span:first-child{transform:translateY(3.3px) rotate(45deg)}
.burger[aria-expanded="true"] span:last-child{transform:translateY(-3.3px) rotate(-45deg)}

/* shared.css:46 — the container home-r9.css never defines. */
.bar nav{display:flex;gap:clamp(16px,1.8vw,28px)}
/* home-r9.css:89-95 verbatim. */
.bar nav a{font-size:14px;font-weight:500;opacity:.72;padding:4px 0;position:relative;
  transition:opacity .3s ease}
.bar nav a::after{content:"";position:absolute;left:0;right:0;bottom:0;height:1.5px;
  background:var(--bar-acc);transform:scaleX(0);transform-origin:0 50%;
  transition:transform .4s cubic-bezier(.16,1,.3,1),background-color .55s cubic-bezier(.4,0,.2,1)}
.bar nav a:hover{opacity:1}
.bar nav a:hover::after{transform:scaleX(1)}
/* shared.css:52 — the active state. Not in home-r9.css. */
.bar nav a[aria-current]::after{transform:scaleX(1)}

/* home-r9.css:97-104 — the persistent CTA pill. Background is --bar-acc, so it
   is magenta on light grounds and AQUA on dark ones. Padding is deliberately
   asymmetric (19px right / 22px left) to balance the trailing arrow. */
.hire{display:inline-flex;align-items:center;gap:10px;padding:12px 19px 12px 22px;border-radius:100px;
  background:var(--bar-acc);color:var(--bar-cta-fg);font-weight:600;font-size:14.5px;white-space:nowrap;
  transition:background-color .55s cubic-bezier(.4,0,.2,1),
             color .55s cubic-bezier(.4,0,.2,1),
             transform .35s cubic-bezier(.16,1,.3,1)}
.hire svg{width:15px;height:15px;transition:transform .35s cubic-bezier(.16,1,.3,1)}
.hire:hover{transform:translateY(-2px)}
.hire:hover svg{transform:translateX(4px)}


/* ==========================================================================
   05  MENU OVERLAY
   home-r9.css:77-88 verbatim.

   TRAP (mobile-menu.tsx:9-32): .menu must be a SIBLING of .bar, never a
   descendant of <header>. backdrop-filter and transform both make an ancestor
   the containing block for position:fixed descendants, which traps a
   "fullscreen" overlay inside the bar's own small box. Verify by measuring the
   opened panel: a trapped overlay reports the nav's box, a correct one reports
   the viewport.
   ========================================================================== */
.menu{position:fixed;inset:0;z-index:65;background:var(--ink);color:#fff;
  display:grid;align-content:center;gap:clamp(20px,3vh,36px);
  padding:clamp(90px,12vh,140px) var(--pad) clamp(30px,5vh,60px)}
.menu[hidden]{display:none}
.menu__nav{display:grid;gap:clamp(2px,.6vh,8px)}
.menu__nav a{font-weight:800;letter-spacing:-.04em;line-height:1.02;
  font-size:clamp(2.1rem,7vw,5.4rem);display:block;overflow:hidden}
.menu__nav a span{display:block;transition:transform .5s cubic-bezier(.16,1,.3,1),color .3s ease}
.menu__nav a:hover span{transform:translateX(clamp(10px,1.6vw,26px));color:var(--aqua)}
.menu__foot{display:flex;flex-wrap:wrap;gap:clamp(14px,2.4vw,34px);
  padding-top:clamp(16px,2.4vh,26px);border-top:1px solid rgba(255,255,255,.2);
  font-size:15px;opacity:.76}
.menu__foot a:hover{color:var(--aqua)}


/* ==========================================================================
   06  BUTTONS
   home-r9.css:122-129 verbatim.

   .btn--ghost is the one straight CONFLICT between the two source files:
   home-r9.css:128 writes it for a LIGHT ground (ink text, ink-tinted border),
   shared.css:67 rewrites it for a DARK ground (inherit, white border). Neither
   is wrong — it is the same button on opposite grounds. Resolved here by
   grounding the selector rather than picking a winner. PHASE 2 TO CONFIRM
   (design-kit.md G13).
   ========================================================================== */
.btn{display:inline-flex;align-items:center;gap:11px;padding:19px 30px;border-radius:100px;
  background:var(--magenta);color:#fff;font-weight:600;font-size:16px;
  transition:transform .4s cubic-bezier(.16,1,.3,1),box-shadow .4s ease}
.btn svg{width:16px;height:16px;transition:transform .4s cubic-bezier(.16,1,.3,1)}
.btn:hover{transform:translateY(-3px);box-shadow:0 16px 34px -16px rgba(214,0,107,.8)}
.btn:hover svg{transform:translateX(5px)}

/* home-r9.css:128-129 — light grounds. */
.btn--ghost{background:transparent;color:var(--ink);border:1.5px solid rgba(14,14,18,.24)}
.btn--ghost:hover{border-color:var(--ink);box-shadow:none}
/* shared.css:67-68 — dark grounds. */
.p--ink .btn--ghost,.p--navy .btn--ghost,.p--magenta .btn--ghost{
  color:inherit;border:1.5px solid rgba(255,255,255,.4)}
.p--ink .btn--ghost:hover,.p--navy .btn--ghost:hover,.p--magenta .btn--ghost:hover{
  border-color:#fff;box-shadow:none}

/* home-r9.css:121 — the action row under a hero or panel heading. */
.hero__act{display:flex;flex-wrap:wrap;gap:14px;align-items:center}


/* ==========================================================================
   07  PANELS, GROUNDS, CORNERFILL

   Two layers, deliberately:

   (a) .panel on its own is the INNER-PAGE panel — non-sticky, ordinary block
       padding. shared.css:78-79. This is the default because an inner page is
       not a chapter stack.

   (b) .stack .panel is the HOMEPAGE chapter panel — sticky, full viewport,
       rounded top corners. Values are home-r9.css:142-146 verbatim; the ONLY
       change is scoping to .stack, which is a real existing class
       (home-r9.css:136, home-body.tsx:49) and is the only place .panel is ever
       sticky on the live page.

   THE GROUND SEQUENCE. No two adjacent panels share a ground; the sequence
   alternates dark/light so every boundary is a hard cut. Aqua appears at most
   once, late. Navy closes. See design-kit.md §1.2.

   THE CORNERFILL TRAP. .cornerfill paints the colour revealed through the next
   panel's rounded top corners — and that colour is the colour of the pane
   ABOVE the boundary, NOT the panel being opened. chapter-panel.tsx:15-31
   documents the full table and refuses to infer it from panelBg for exactly
   this reason. Get it wrong and a curve reveals the wrong colour.
       hero(ink)      -> cf--ink     -> p--white   #work
       wstack(ink)    -> cf--ink     -> p--magenta #services
       svcstack(mag)  -> cf--magenta -> p--ink     (process)
       process(ink)   -> cf--ink     -> p--white   #pricing
       pricing(white) -> cf--white   -> p--magenta #faq
       faq(magenta)   -> cf--magenta -> p--aqua    (quote)
       quote(aqua)    -> cf--aqua    -> p--navy    #end
   Only four cf-- modifiers exist. cf--navy and cf--paper do not (G7).
   ========================================================================== */

/* shared.css:78-79 — inner-page panel. */
.panel{padding:clamp(110px,16vh,180px) var(--pad) clamp(56px,8vh,96px)}
.panel--tight{padding-top:clamp(140px,18vh,200px);padding-bottom:clamp(48px,6vh,72px)}

/* home-r9.css:147-153 — the five grounds. p--paper is shared.css:82 (an inner
   page can sit on the body colour; the homepage never does). */
.p--ink{background:var(--ink);color:var(--white)}
.p--white{background:var(--white);color:var(--ink)}
.p--paper{background:var(--paper);color:var(--ink)}
.p--magenta{background:var(--magenta);color:#fff}
.p--aqua{background:var(--aqua);color:var(--ink)}
.p--navy{background:var(--navy);color:#fff}

/* home-r9.css:136-141 — the stack wrapper and the corner fills. .stack holds
   the hero's ink so the FIRST panel's corners read as the hero rather than as
   the body's paper (home-r9.css:132-135). */
.stack{position:relative;background:var(--ink)}
.cornerfill{position:sticky;top:0;height:var(--r);margin-bottom:calc(var(--r) * -1)}
.cf--ink{background:var(--ink)}
.cf--white{background:var(--white)}
.cf--magenta{background:var(--magenta)}
.cf--aqua{background:var(--aqua)}

/* home-r9.css:142-146 verbatim, scoped to .stack. */
.stack .panel{position:sticky;top:0;min-height:100svh;
  padding:clamp(84px,10vh,140px) var(--pad) clamp(40px,6vh,80px);
  border-radius:var(--r) var(--r) 0 0;display:grid;align-content:center;overflow:hidden}
.stack .panel::before{content:"";position:absolute;top:0;left:0;height:3px;width:100%;
  background:var(--magenta);transform:scaleX(0);transform-origin:0 50%}
.stack .panel.in::before{transform:scaleX(1);transition:transform 1.1s cubic-bezier(.16,1,.3,1) .1s}
/* home-r9.css:150,152 — the top rule changes colour so it never disappears. */
.stack .p--magenta::before{background:var(--aqua)}
.stack .p--aqua::before{background:var(--ink)}


/* ==========================================================================
   08  SECTION SHELLS
   home-r9.css:169-171 verbatim. .worksec is the closest thing to a non-sticky
   inner-page section shell that already exists: a white section carrying the
   same top-corner --r treatment, whose cards sit on #F4F3F1.
   ========================================================================== */
.worksec{position:relative;z-index:1;background:var(--white);color:var(--ink);
  border-radius:var(--r) var(--r) 0 0;padding:clamp(74px,9vh,120px) var(--pad) clamp(56px,8vh,96px)}
.worksec .card{background:#F4F3F1}


/* ==========================================================================
   09  CARDS
   Two distinct card treatments, not variants of one.

   .card          home-r9.css:215-233 — the base card. Soft, borderless, media
                  on top, 18px radius, magenta rule wipes in on hover.
                  SPARE: 0 on the live homepage. Designed for index grids.

   .cards--2 .card
                  home-r9.css:167-204 — a DIFFERENT card: white, 1px ink
                  border, title bar ABOVE the media separated by an ink rule,
                  squared-off well, and a full-bleed scrim carrying the
                  supporting line on hover or :focus-visible. Round 1 used this
                  for /projects and it rendered well.
   ========================================================================== */

/* home-r9.css:165-166 */
.cards{margin-top:clamp(28px,4.4vh,54px);display:grid;gap:clamp(12px,1.4vw,20px)}
.cards--3{grid-template-columns:repeat(3,minmax(0,1fr))}
/* NOTE: .cards--6 is deliberately absent. home-r9.css references it only in
   two media queries (509, 514) and never defines a base rule, so above 1080px
   it renders as one column. An incomplete pattern is worse than none — see
   design-kit.md G8. */

/* --- base card -------------------------------------------------- */
/* home-r9.css:215-233 verbatim. */
.card{position:relative;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;
  background:var(--paper);color:var(--ink);text-decoration:none;isolation:isolate;
  transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .5s cubic-bezier(.16,1,.3,1)}
.p--white .card{background:#F4F3F1}
.card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;z-index:3;
  background:var(--magenta);transform:scaleX(0);transform-origin:0 50%;
  transition:transform .55s cubic-bezier(.16,1,.3,1)}
.card:hover{transform:translateY(-5px);box-shadow:0 22px 44px -26px rgba(14,14,18,.55)}
.card:hover::before{transform:scaleX(1)}
.card__well{position:relative;aspect-ratio:16/11;overflow:hidden;background:var(--navy)}
.card__well img,.card__well video{width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .8s cubic-bezier(.16,1,.3,1)}
.card:hover .card__well img,.card:hover .card__well video{transform:scale(1.05)}
.card__body{padding:14px 16px 17px;display:grid;gap:5px}
.card__t{font-weight:700;font-size:clamp(1rem,1.42vw,1.28rem);letter-spacing:-.022em}
.card__s{font-size:13.5px;line-height:1.4;opacity:.72}
.card__tag{position:absolute;top:10px;left:10px;z-index:2;font-size:10.5px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;padding:5px 9px;border-radius:100px;
  background:rgba(255,255,255,.92);color:var(--ink)}

/* --- bordered two-up card --------------------------------------- */
/* home-r9.css:167-198 verbatim, except .card__tag z-index — see below. */
.cards--2{grid-template-columns:repeat(2,minmax(0,1fr));
  gap:clamp(18px,2.1vw,34px);margin-top:clamp(40px,6vh,72px)}
.cards--2 .card{display:block;background:var(--white);color:var(--ink);
  border:1px solid var(--ink);border-radius:clamp(16px,1.7vw,24px);padding:0;overflow:hidden}
.cards--2 .card::before{display:none}
.cards--2 .card:hover{transform:translateY(-4px);box-shadow:0 28px 54px -30px rgba(14,14,18,.55)}
.cards--2 .card__t{display:block;background:var(--white);color:var(--ink);font-weight:600;
  border-bottom:1px solid var(--ink);
  padding:clamp(15px,1.35vw,20px) clamp(17px,1.5vw,23px);
  font-size:clamp(1.12rem,1.62vw,1.45rem);letter-spacing:-.02em;line-height:1.24;
  margin-bottom:0;transition:color .3s ease}
.cards--2 .card:hover .card__t{color:var(--magenta)}
/* shared.css:94-99 — title bar as a flex row with a trailing <small>. An
   extension of the same title bar, not a new component. */
.cards--2 .card__t--row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.cards--2 .card__t small{font-weight:500;font-size:12px;letter-spacing:.08em;
  text-transform:uppercase;opacity:.55}
.cards--2 .card__well{position:relative;aspect-ratio:16/10;overflow:hidden;border-radius:0;
  background:var(--navy)}
.cards--2 .card__s{position:absolute;inset:0;z-index:3;display:grid;place-content:center;
  text-align:center;padding:clamp(22px,2.4vw,40px);
  color:#fff;font-size:clamp(14.5px,1.05vw,16px);line-height:1.5;
  background:rgba(8,8,12,.82);opacity:0;
  transition:opacity .4s ease}
.cards--2 .card__s>span{display:block;max-width:34ch;margin:0 auto;transform:translateY(8px);
  transition:transform .5s cubic-bezier(.16,1,.3,1)}
/* :focus-visible parity with :hover is explicit in the source — keyboard users
   get the supporting line too. */
.cards--2 .card:hover .card__s,
.cards--2 .card:focus-visible .card__s{opacity:1}
.cards--2 .card:hover .card__s>span,
.cards--2 .card:focus-visible .card__s>span{transform:translateY(0)}
/* home-r9.css:197-198 for the values; z-index:4 from shared.css:111. This is a
   real fix, not a preference: base .card__tag is z-index:2 (231) and .card__s
   is z-index:3 (186), so on .cards--2 the hover scrim covered the tag. */
.cards--2 .card__tag{top:14px;left:14px;z-index:4;background:rgba(255,255,255,.94);
  color:var(--ink);font-weight:700;letter-spacing:.07em;padding:6px 11px}

/* home-r9.css:199-204 — on touch there is no hover to give, so the supporting
   line becomes a permanent bottom gradient instead of a full-bleed scrim. */
@media (hover:none){
  .cards--2 .card__s{opacity:1;inset:auto 0 0 0;display:block;text-align:left;
    background:linear-gradient(to top,rgba(6,6,10,.9) 0%,rgba(6,6,10,.6) 55%,rgba(6,6,10,0) 100%);
    padding:clamp(16px,1.5vw,24px)}
  .cards--2 .card__s>span{transform:none;max-width:none;margin:0}
}


/* ==========================================================================
   10  SLOT — "awaiting footage"
   home-r9.css:206-214 verbatim (.slot__s gets shared.css:129's text-align and
   max-width, which stop a two-line sub-label ragging).

   THIS IS THE HONESTY MECHANISM, not decoration. A project with no real video
   gets this designed box — never a fabricated or stand-in screenshot of a real
   client's site (session.md:216-219, brief.md:37-44). 10 of the 13 case
   studies need it.
   ========================================================================== */
.slot{position:absolute;inset:0;display:grid;place-content:center;gap:9px;justify-items:center;
  background:repeating-linear-gradient(45deg,#171A24 0 11px,#1E222E 11px 22px);color:rgba(255,255,255,.62)}
.slot__i{width:34px;height:34px;border:1.6px solid var(--aqua);border-radius:50%;
  display:grid;place-content:center;color:var(--aqua)}
.slot__i::after{content:"";width:0;height:0;border-left:10px solid currentColor;
  border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px}
.slot__t{font-size:12px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
.slot__s{font-size:11.5px;opacity:.62;letter-spacing:.04em;text-align:center;max-width:22ch}


/* ==========================================================================
   11  MOCK — drawn browser
   home-r9.css:236-249 verbatim. A tinted canvas, skeleton bars, and EXACTLY
   ONE live element. SPARE: 0 on the live homepage. Use where no real capture
   exists and .slot would read as a missing video rather than a drawn site.
   The pulse keyframes live in §23.
   ========================================================================== */
.mock{position:absolute;inset:0;background:var(--navy);padding:11% 9%;display:grid;
  align-content:start;gap:6.5%}
.mock__bar{height:5.5%;border-radius:3px;background:rgba(255,255,255,.19)}
.mock__bar.w80{width:80%}.mock__bar.w60{width:60%}.mock__bar.w45{width:45%}.mock__bar.w70{width:70%}
.mock__live{display:inline-flex;align-items:center;gap:7px;align-self:start;
  padding:6px 11px;border-radius:100px;font-size:11.5px;font-weight:700;letter-spacing:.01em;
  background:var(--magenta);color:#fff;white-space:nowrap}
.mock__live i{width:6px;height:6px;border-radius:50%;background:currentColor;font-style:normal}
.mock__live--aqua{background:var(--aqua);color:var(--ink)}
.mock__row{display:flex;align-items:center;gap:8px}
.mock__dot{width:9px;height:9px;border-radius:50%;border:1.5px solid rgba(255,255,255,.4)}
.mock__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.mock__cell{aspect-ratio:1;border-radius:4px;background:rgba(255,255,255,.16)}
.mock__cell.on{background:var(--aqua)}


/* ==========================================================================
   12  ROW LIST — light ground
   home-r9.css:313-323 verbatim. A dense full-width index row whose magenta
   fill WIPES UP FROM THE BOTTOM (transform-origin:50% 100%) and bleeds 14px
   past the text horizontally. SPARE: 0 on the live homepage.
   Designed for: blog index, location index — anything that must stay dense.
   ========================================================================== */
.work{display:grid;margin-top:clamp(34px,5vh,58px);border-top:1px solid rgba(14,14,18,.14)}
.row{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;
  padding:clamp(18px,2.6vh,30px) 4px;border-bottom:1px solid rgba(14,14,18,.14);
  position:relative;cursor:pointer}
.row::after{content:"";position:absolute;inset:0 -14px;background:var(--magenta);
  transform:scaleY(0);transform-origin:50% 100%;
  transition:transform .5s cubic-bezier(.16,1,.3,1);z-index:0;border-radius:6px}
.row:hover::after{transform:scaleY(1)}
.row>*{position:relative;z-index:1;transition:color .4s ease}
.row:hover .row__n,.row:hover .row__m{color:#fff}
.row__n{font-weight:700;font-size:clamp(1.4rem,3.4vw,2.9rem);letter-spacing:-.032em}
.row__m{font-size:14.5px;color:#5E5E68;text-align:right;font-weight:500}
.row__m em{font-style:normal;display:block;font-size:12px;letter-spacing:.09em;
  text-transform:uppercase;opacity:.72;margin-top:3px}


/* ==========================================================================
   13  SVC LIST — dark ground
   home-r9.css:362-367 verbatim. The dark-ground sibling of .row: white rules,
   no fill, hover shifts the row 14px right. SPARE: 0 on the live homepage.
   ========================================================================== */
.svcs{margin-top:clamp(30px,5vh,54px);display:grid;gap:0;border-top:1px solid rgba(255,255,255,.28)}
.svc{padding:clamp(16px,2.4vh,26px) 0;border-bottom:1px solid rgba(255,255,255,.28);
  display:grid;grid-template-columns:1fr auto;gap:18px;align-items:baseline;
  transition:padding-left .45s cubic-bezier(.16,1,.3,1)}
.svc:hover{padding-left:14px}
.svc__n{font-weight:700;font-size:clamp(1.3rem,3.1vw,2.6rem);letter-spacing:-.03em}
.svc__d{font-size:14.5px;opacity:.84;max-width:38ch;text-align:right;line-height:1.42}


/* ==========================================================================
   14  SVCCARD STACK
   home-r9.css:336-359 verbatim. Each card pins 10px lower than the last via
   --i, so the stack fans rather than covering. The shadow is UPWARD
   (0 -26px …) because the card above is what needs separating.
   --i must be an inline custom property on each card (services-stack.tsx:44):
     <article class="svccard svccard--ink" style="--i:0"> … </article>
   ========================================================================== */
.svcstack{position:relative;z-index:1;padding:0 var(--pad) 12vh}
.svccard{position:sticky;top:calc(clamp(76px,10vh,94px) + var(--i) * 10px);
  height:min(80vh,720px);border-radius:26px;overflow:hidden;
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.02fr);
  margin-bottom:16vh;box-shadow:0 -26px 70px -46px rgba(14,14,18,.62)}
.svccard:last-child{margin-bottom:0}
.svccard--ink{background:var(--ink);color:#fff}
.svccard--magenta{background:var(--magenta);color:#fff}
.svccard--white{background:var(--white);color:var(--ink)}
.svccard--navy{background:var(--navy);color:#fff}
.svccard--aqua{background:var(--aqua);color:var(--ink)}
.svccard__body{padding:clamp(24px,3.4vw,58px);display:grid;align-content:center;gap:clamp(12px,1.6vh,20px)}
.svccard__ix{font-size:12.5px;font-weight:700;letter-spacing:.13em;opacity:.97}
.svccard__t{font-weight:800;letter-spacing:-.038em;line-height:.94;
  font-size:clamp(1.9rem,4.4vw,4rem)}
.svccard__d{max-width:34ch;font-size:clamp(.98rem,1.16vw,1.16rem);line-height:1.5;opacity:.97}
.svccard__l{margin-top:6px;display:inline-flex;align-items:center;gap:9px;align-self:start;
  font-weight:600;font-size:15px;border-bottom:1.5px solid currentColor;padding-bottom:3px;
  transition:gap .35s cubic-bezier(.16,1,.3,1)}
.svccard__l:hover{gap:15px}
.svccard__well{position:relative;overflow:hidden}
.svccard__well img,.svccard__well video{width:100%;height:100%;object-fit:cover;display:block;
  transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
.svccard:hover .svccard__well img,.svccard:hover .svccard__well video{transform:scale(1.045)}


/* ==========================================================================
   15  WPANEL STACK — full-bleed video
   home-r9.css:256-310 verbatim.

   THREE TRAPS live in this pattern and all three are load-bearing:

   1. .wstack::after{height:100lvh} is what lets the LAST panel pin at all.
      position:sticky gets its room only from in-flow content AFTER the
      element: a margin-bottom on the sticky element gives none (the spec
      clamps its margin box) and padding on the container gives none (padding
      is outside the content box). Both were tried and both measured 0px of pin
      for the last panel against 840-3940px for its siblings
      (home-r9.css:256-269).

   2. lvh, not svh. svh is the SMALLEST viewport height, so a 100svh panel
      becomes shorter than the screen the moment mobile browser chrome
      retracts, leaking a strip of the next colour. Untestable on desktop.

   3. The panel needs its OWN dark background, set on the element
      (work-stack.tsx:40 uses style="background-color:var(--ink)"). Until the
      IntersectionObserver fires there is no video and .wstack is white, so the
      panel would flash white (lazy-video.tsx:22-26).

   The scrim is sized so white text clears 4.5:1 even against a pure-white
   video frame — ~.55 alpha minimum (home-r9.css:281-285).
   ========================================================================== */
.wstack{display:flow-root;background:var(--white)}
.wstack::after{content:"";display:block;height:100lvh}
.wpanel{position:sticky;top:0;height:100lvh;overflow:hidden;color:#fff;
  border-radius:var(--r) var(--r) 0 0;display:grid;align-content:center;
  padding:clamp(60px,8vh,110px) var(--pad);
  margin-bottom:26vh}
.wpanel:last-child{margin-bottom:0}
.wpanel video,.wpanel img{position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;z-index:0}
.wpanel::after{content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(to bottom,rgba(6,6,10,.42) 0%,rgba(6,6,10,.72) 32%,
    rgba(6,6,10,.74) 68%,rgba(6,6,10,.46) 100%)}
/* home-r9.css:289-294 — on desktop the copy is a narrow left column, so the
   scrim is weighted horizontally instead, keeping more footage readable. */
@media (min-width:901px){
  .wpanel::after{background:linear-gradient(to right,rgba(6,6,10,.86) 0%,
    rgba(6,6,10,.76) 42%,rgba(6,6,10,.30) 72%,rgba(6,6,10,.14) 100%)}
}
.wpanel>*{position:relative;z-index:2}
/* home-r9.css:297-300 — this is h2's type spec verbatim, on purpose: the
   client name and the chapter heading are peers. Mirror every h2 breakpoint
   (including the max-height one in §22) or they drift apart on short screens. */
.wpanel__n{font-weight:800;letter-spacing:-.034em;line-height:.9;
  font-size:clamp(2.2rem,6.6vw,6.2rem);max-width:14ch}
.wpanel__d{margin-top:16px;max-width:44ch;line-height:1.5;opacity:.9;
  font-size:clamp(1rem,1.15vw,1.15rem)}
.wpanel__r{margin-top:22px;display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.wpanel__l{display:inline-flex;align-items:center;gap:9px;font-weight:600;font-size:16px;
  border-bottom:1.5px solid rgba(255,255,255,.5);padding:14px 0 11px;
  transition:gap .35s cubic-bezier(.16,1,.3,1)}
.wpanel__l:hover{gap:15px}
/* must clear the fixed bar */
.wpanel__ix{position:absolute;top:clamp(96px,13vh,124px);left:var(--pad);z-index:2;
  font-size:12.5px;font-weight:700;letter-spacing:.13em;opacity:.75}


/* ==========================================================================
   16  STEPS
   home-r9.css:370-382 verbatim. Numbered process list on a dark ground. The
   aqua rule above each step draws left-to-right over 1s with a .14s stagger
   once the section latches `.in`. The stagger delays are in §23.
   ========================================================================== */
.steps{margin-top:clamp(34px,5vh,60px);display:grid;gap:0}
.step{display:grid;grid-template-columns:clamp(46px,6vw,96px) 1fr;gap:clamp(16px,3vw,44px);
  padding:clamp(18px,2.8vh,32px) 0;border-top:1px solid rgba(255,255,255,.24);position:relative}
.step:last-child{border-bottom:1px solid rgba(255,255,255,.24)}
.step__r{position:absolute;top:-1px;left:0;height:1px;width:100%;background:var(--aqua);
  transform:scaleX(0);transform-origin:0 50%}
.step__k{font-weight:800;font-size:clamp(1.1rem,2vw,1.9rem);letter-spacing:-.03em;color:var(--aqua)}
.step__t{font-weight:700;font-size:clamp(1.25rem,2.9vw,2.3rem);letter-spacing:-.028em}
.step__b{margin-top:9px;max-width:50ch;opacity:.8;line-height:1.5;font-size:15.5px}


/* ==========================================================================
   17  PRICING
   home-r9.css:385-429 verbatim, with two values taken from shared.css where
   round 1 adapted the pattern for a different job (noted inline).

   TRAP — PRICES WITH COMMAS. .tier__f / .tcard__f carry NO font-variant-numeric
   and must never be given a monospaced face. Tabular figures and mono faces
   both give the thousands comma a full digit advance, so GBP 1,995 renders as
   "1 , 995" — invisible in markup, obvious on screen, and it corrupts a PRICE.
   It INHERITS, so check font-variant-numeric AND font-family up the whole
   ancestor chain. Archivo only for comma'd figures (pricing.tsx:21-25).
   ========================================================================== */
.payhead{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:clamp(20px,3vh,34px)}

/* home-r9.css:386-391 for the pattern; sizes from shared.css:134-139, because
   five filter chips have to fit where two payment modes did. The homepage's
   own values are 14.5px / padding 10px 20px / track rgba(14,14,18,.075). */
.paytoggle{display:inline-flex;padding:4px;gap:4px;border-radius:100px;
  background:rgba(14,14,18,.06);flex-wrap:wrap}
.paytoggle button{border:0;background:none;font:inherit;font-weight:600;font-size:13.5px;
  padding:9px 16px;border-radius:100px;cursor:pointer;color:inherit;opacity:.6;white-space:nowrap;
  transition:background-color .35s cubic-bezier(.16,1,.3,1),color .3s ease,opacity .3s ease}
.paytoggle button[aria-pressed="true"]{background:var(--ink);color:#fff;opacity:1}
.paytoggle button:hover{opacity:1}

/* home-r9.css:393-409. Note the SECOND column is deliberately wider (1.05fr). */
.price{margin-top:clamp(30px,4.6vh,54px);display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);
  gap:clamp(22px,3.4vw,58px);align-items:start}
.tiers{display:grid;border-top:1px solid rgba(14,14,18,.16)}
.tier{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;width:100%;
  padding:clamp(15px,2.2vh,24px) 6px;border-bottom:1px solid rgba(14,14,18,.16);
  background:none;border-left:0;border-right:0;border-top:0;font:inherit;color:inherit;
  text-align:left;cursor:pointer;
  transition:background .35s ease,padding-left .35s cubic-bezier(.16,1,.3,1)}
.tier:hover{background:rgba(14,14,18,.045);padding-left:12px}
.tier[aria-selected="true"]{background:var(--ink);color:var(--white);padding-left:14px}
.tier__n{display:block;font-weight:700;font-size:clamp(1.15rem,2.3vw,1.75rem);letter-spacing:-.028em}
.tier__s{display:block;font-size:13px;opacity:.66;margin-top:2px}
/* right-aligned EXPLICITLY: the figure is inline text above a block <small>,
   so with default alignment it only lined up when the two happened to be the
   same width — true for "750" over "+ 10/mo", false for "45" over "per month",
   which sat 16px short (home-r9.css:404-407). */
.tier__f{font-weight:700;font-size:clamp(1.05rem,2vw,1.5rem);letter-spacing:-.02em;
  white-space:nowrap;text-align:right}
.tier__f small{display:block;font-size:12.5px;font-weight:500;opacity:.6;letter-spacing:0;margin-top:2px}

/* home-r9.css:413-423. The two min-heights reserve two lines for the head and
   three for the paragraph so every tier's panel is the same height without
   hard-coding one — only the eCommerce head wraps, and that was the whole 39px
   spread (home-r9.css:417-419).
   NOTE: top:120px assumes the 81px bar plus clearance. A page with a different
   bar height inherits a wrong number (design-kit.md §12.8). */
.detail{background:var(--ink);color:#fff;border-radius:calc(var(--r)*.7);
  padding:clamp(15px,2.2vh,24px) clamp(22px,3vw,40px) clamp(22px,3vw,40px);
  position:sticky;top:120px;
  display:grid;grid-template-rows:auto auto 1fr auto;align-content:start}
.detail__h{min-height:2em;font-weight:800;font-size:clamp(1.5rem,3vw,2.4rem);
  letter-spacing:-.032em;line-height:1}
.detail__p{min-height:3em;margin-top:14px;opacity:.8;line-height:1.5;font-size:15.5px}
.detail .btn{margin-top:26px}

/* home-r9.css:424-426 for the pattern; sizes from shared.css:147-149. On the
   homepage this list sits inside a compact ink pane at 15px; on a content page
   it is body copy and takes the 16px prose floor. THE AQUA CHECK IS THE POINT —
   it is the design's one "included / confirmed" idiom. */
.detail__l{margin-top:22px;display:grid;gap:12px}
.detail__l div{display:flex;gap:12px;align-items:flex-start;font-size:16px;line-height:1.5}
.detail__l svg{width:16px;height:16px;flex:none;margin-top:4px;color:var(--aqua)}

/* home-r9.css:428-429 — replayed by remounting the node (pricing.tsx:19-24). */
.swap{animation:swap .45s cubic-bezier(.16,1,.3,1)}
@keyframes swap{from{transform:translateY(8px)}to{transform:translateY(0)}}

/* home-r9.css:555 + 665-687 — MOBILE pricing. Off by default; shown below
   901px in §22. Whole cards instead of the tablist, because in one column the
   detail pane lands off-screen and a tap reads as nothing happening
   (home-r9.css:660-662). */
.tiercards{display:none}
.tcard{position:relative;border:1px solid rgba(14,14,18,.2);border-radius:18px;
  padding:22px 20px;display:grid;gap:12px;background:#F7F6F4}
.tcard--rec{background:var(--ink);color:#fff;border-color:var(--ink)}
.tcard__b{position:absolute;top:-10px;left:20px;background:var(--magenta);color:#fff;
  font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
  padding:5px 11px;border-radius:100px}
.tcard__h{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.tcard__n{display:block;font-weight:700;font-size:1.4rem;letter-spacing:-.028em}
.tcard__s{display:block;font-size:14.5px;opacity:.7;margin-top:3px}
.tcard__f{font-weight:800;font-size:1.75rem;letter-spacing:-.03em;
  white-space:nowrap;text-align:right;line-height:1}
.tcard__f small{display:block;font-size:12.5px;font-weight:500;opacity:.62;margin-top:4px}
.tcard__p{font-size:16px;line-height:1.45;opacity:.82}
.tcard__l{display:grid;gap:8px;list-style:none}
.tcard__l li{display:flex;gap:10px;align-items:flex-start;font-size:16px;line-height:1.45}
.tcard__l svg{width:15px;height:15px;flex:none;margin-top:3px;color:var(--magenta)}
.tcard--rec .tcard__l svg{color:var(--aqua)}
.tcard .btn{margin-top:4px;justify-content:center;padding:16px 24px}
.tcard--rec .btn{background:var(--aqua);color:var(--ink)}


/* ==========================================================================
   18  QUESTIONS — accordion
   home-r9.css:432-446 verbatim. Native <details>/<summary> deliberately, so
   the CSS can hook [open] and its pseudo-selectors; reimplementing with JS
   state decouples the markup from this stylesheet (questions.tsx:1-7).
   Rules are white — this pattern assumes a dark or magenta ground.
   ========================================================================== */
.qa{margin-top:clamp(26px,4vh,48px);border-top:1px solid rgba(255,255,255,.22)}
.qa details{border-bottom:1px solid rgba(255,255,255,.22)}
.qa summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:18px;
  padding:clamp(13px,2vh,21px) 4px;font-weight:700;letter-spacing:-.022em;
  font-size:clamp(1.02rem,1.75vw,1.42rem);transition:padding-left .35s cubic-bezier(.16,1,.3,1)}
.qa summary::-webkit-details-marker{display:none}
.qa summary:hover{padding-left:12px}
.qa summary::after{content:"";margin-left:auto;flex:none;width:13px;height:13px;
  border-right:2px solid var(--aqua);border-bottom:2px solid var(--aqua);
  transform:rotate(45deg) translate(-3px,-3px);transition:transform .4s cubic-bezier(.16,1,.3,1)}
.qa details[open] summary::after{transform:rotate(-135deg) translate(-3px,-3px)}
/* the grid-template-rows 0fr -> 1fr height-animation trick */
.qa__a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.16,1,.3,1)}
.qa details[open] .qa__a{grid-template-rows:1fr}
.qa__a>div{overflow:hidden}
.qa__a p{max-width:62ch;padding:0 4px clamp(14px,2vh,22px);opacity:.97;line-height:1.55;font-size:15.5px}


/* ==========================================================================
   19  QUOTE
   Two sizes of ONE pattern, not two patterns.

   .quote        shared.css:152-154 — in-page testimonial. Per decision D3 the
                 three testimonials go inside /projects and against the
                 relevant case studies, where the homepage's 4.6rem version
                 would dominate the page it sits on.
   .quote--hero  home-r9.css:449-451 — the homepage's full-panel version.
   ========================================================================== */
.quote{font-weight:700;letter-spacing:-.036em;line-height:1.05;
  font-size:clamp(1.6rem,3.6vw,2.6rem);max-width:34ch}
.quote--hero{line-height:1.02;font-size:clamp(1.8rem,5.4vw,4.6rem);max-width:19ch}
.quote__a{margin-top:20px;font-size:15px;font-weight:600;letter-spacing:.03em}
.quote--hero+.quote__a{margin-top:clamp(22px,3vw,38px)}
.quote__a span{opacity:.66;font-weight:400}


/* ==========================================================================
   20  END / BIG
   home-r9.css:454-465 verbatim, scoped so it works both as the homepage's
   full-height closing chapter (.stack .end) and as the shorter page-level
   block round 1 used (.end on its own — shared.css:157-161 plus
   project-list.html:13-14's padding).

   NOTE: .end is the homepage's closing CHAPTER, not a footer. A real
   page-level footer does not exist yet — design-kit.md G2.
   ========================================================================== */
.end__main{display:grid;align-content:center;gap:clamp(20px,3vw,34px)}
.end__nav{display:flex;gap:18px;flex-wrap:wrap}
.end__nav a:hover{color:var(--aqua)}
.end__foot{display:flex;justify-content:space-between;gap:22px;flex-wrap:wrap;
  padding-top:clamp(20px,3vh,32px);margin-top:clamp(28px,4vh,48px);
  border-top:1px solid rgba(255,255,255,.22);font-size:13.5px;opacity:.66}
.end h2{max-width:14ch}
/* home-r9.css:454-455 — the full-height homepage version overrides .panel's
   centring: stretch, two rows, no gap, and a much larger top padding. */
.stack .end{align-content:stretch;grid-template-rows:1fr auto;gap:0;
  padding-top:clamp(170px,22vh,260px);padding-bottom:clamp(24px,3vh,38px)}
/* home-r9.css:463-465 — the oversized contact link. */
.big{font-weight:800;letter-spacing:-.04em;font-size:clamp(1.3rem,3.6vw,3rem);
  display:inline-block;border-bottom:2px solid rgba(255,255,255,.3);padding-bottom:5px;
  transition:border-color .35s ease}
.big:hover{border-bottom-color:var(--aqua)}


/* ==========================================================================
   21  FILTER + EMPTY STATE
   shared.css:132-144. Not in home-r9.css — these are the two things round 1
   needed once .paytoggle carried sector filters rather than payment modes.
   Kept because they are compositional (a flex row, a count, a dashed box),
   not a new visual language.

   NOTE: only ONE filter axis exists. Decision D4 (session.md:167-172) needs
   topic AND sector on /blog — two stacked pill groups is untested
   (design-kit.md G9).
   ========================================================================== */
.filterbar{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;
  margin-top:clamp(28px,4vh,44px)}
.count{font-size:13.5px;font-weight:600;opacity:.55}
.empty{margin-top:56px;padding:56px 24px;text-align:center;border:1px dashed rgba(14,14,18,.24);
  border-radius:20px;display:none}
.empty[data-show="true"]{display:block}
.empty p{opacity:.6;font-size:15px;margin-top:6px}


/* ==========================================================================
   22  RESPONSIVE
   home-r9.css:471-523 and 582-720, carried for the patterns this kit includes.

   READ THIS FIRST: max-height:1040px is THE NORMAL LAPTOP CASE, not an edge
   case. Measured live on a 1440x900 machine: the usable viewport is 757px
   tall, the query matches, and h2 computes to 56px (3.5rem) — not the 95px
   that 6.6vw would give. The uncompressed clamp maxima are effectively
   unreachable on ordinary hardware. Design and verify against this scale.

   home-r9.css:467-470 explains why 1040 and not 900: the process section runs
   ~891px of content, which does not fit a 901-1030px viewport, and a sticky
   full-viewport panel hides anything below the fold — so that content was
   unreachable, not merely cramped.
   ========================================================================== */
@media (max-height:1040px){
  .stack h2{font-size:clamp(1.9rem,4.4vw,3.5rem)}
  .wpanel__n{font-size:clamp(1.9rem,4.4vw,3.5rem)}
  .stack .panel{padding-top:clamp(70px,8vh,96px);padding-bottom:clamp(28px,4vh,48px)}
  .svc{padding:clamp(9px,1.5vh,15px) 0}
  .svc__n{font-size:clamp(1.15rem,2.2vw,1.7rem)}
  .step{padding:clamp(10px,1.7vh,18px) 0}
  .step__t{font-size:clamp(1.1rem,2.1vw,1.6rem)}
  .step__b{margin-top:5px;font-size:14.5px}
  .row{padding:clamp(11px,1.7vh,18px) 4px}
  .row__n{font-size:clamp(1.2rem,2.4vw,2rem)}
  .work,.svcs,.steps,.price,.cards{margin-top:clamp(18px,2.6vh,30px)}
  .svccard{height:min(84vh,640px);margin-bottom:13vh}
  .card__well{aspect-ratio:16/9}
  .card__body{padding:11px 13px 13px}
  .card__t{font-size:clamp(.94rem,1.2vw,1.1rem)}
  .card__s{font-size:12.5px}
  .svccard__t{font-size:clamp(1.7rem,3.6vw,2.9rem)}
  .lead{margin-top:14px}
  .quote--hero{font-size:clamp(1.6rem,4vw,3.4rem)}
}

/* home-r9.css:497-499 */
@media (max-width:620px){
  .mark__type{display:none}
}

/* home-r9.css:503-507 */
@media (max-width:820px){
  .svccard{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);height:auto;
    min-height:70vh;margin-bottom:9vh}
  .svccard__well{min-height:230px}
}

/* home-r9.css:500-502,511-523 + shared.css:164-168 */
@media (max-width:900px){
  .cards--3,.cards--2{grid-template-columns:1fr}
  .row{grid-template-columns:1fr}
  .row__m{text-align:left}
  .svc{grid-template-columns:1fr}
  .svc__d{text-align:left}
  .price{grid-template-columns:1fr}
  .detail{position:static}
  /* the sticky chapter stack is a large-screen affordance only */
  .stack .panel{position:relative;min-height:auto}
  .filterbar{align-items:flex-start}
  /* shared.css:166 — the inner-page nav collapses to the burger. Phase 2 owns
     what the overlay then contains (design-kit.md G1). */
  .bar nav{display:none}
}

/* home-r9.css:582-714 — THE AUTHORED MOBILE LAYER. Authored, not reflowed
   (home-r9.css:544-551). Doctrine: 16px prose floor, 44px touch targets,
   display type sized from the longest unbreakable word, and no eyebrow allowed
   to outweigh the heading it introduces.

   WARNING: this block was NOT verified in a rendered 390px viewport during
   Phase 1 — window resize was a no-op in the available browser. It is copied
   faithfully from source. Phase 2 must render at 390px before trusting it.
   See design-kit.md §14. */
@media (max-width:900px){
  /* safe area: the bar and every full-bleed edge must clear the notch */
  :root{--pad:max(20px,env(safe-area-inset-left),env(safe-area-inset-right))}
  .bar{padding-top:max(10px,env(safe-area-inset-top));padding-bottom:10px}
  .menu{padding-bottom:max(30px,env(safe-area-inset-bottom))}

  /* 44px touch floor */
  .burger{width:44px;height:44px}
  .hire{padding:14px 20px 14px 23px;font-size:15px}
  .mark{padding:9px 0}
  .svccard__l{padding:13px 0;font-size:16px}
  .qa summary{padding-top:16px;padding-bottom:16px}
  .end__nav a{padding:13px 0}

  .hero h1,.stack h1{font-size:clamp(2.6rem,14.3vw,3.9rem);letter-spacing:-.042em}

  /* lvh, not svh: svh is the SMALLEST viewport, so the section would be
     shorter than the screen when browser chrome retracts and would leak a
     strip of the next colour. The +110px is dwell — at exactly 100lvh the
     all-one-colour state lasts the 65px the fixed bar overlaps, one frame at
     flick speed (home-r9.css:614-621). */
  .stack .panel{min-height:calc(100lvh + 110px)}
  .stack h2{font-size:clamp(2rem,8.6vw,2.4rem);line-height:.94;max-width:none}
  .lead{font-size:16px;margin-top:16px;max-width:none}

  /* the unaided rest colour — see §03 */
  .res{color:#5A5A66}

  .wpanel__n{font-size:clamp(2rem,8.6vw,2.4rem);line-height:.94;max-width:none}
  .wpanel__d{font-size:16px;max-width:none}
  .wpanel__ix{top:calc(84px + env(safe-area-inset-top))}
  .wpanel{margin-bottom:22vh}

  /* one card, one screen, under the bar */
  .svccard{height:calc(100svh - 118px);min-height:0;
    grid-template-rows:auto minmax(0,1fr);
    top:calc(72px + var(--i) * 6px);margin-bottom:11vh}
  .svccard__body{padding:26px 22px 22px;gap:11px;align-content:start}
  .svccard__ix{font-size:12px;letter-spacing:.12em;opacity:.97;margin-bottom:2px}
  .svccard__t{font-size:min(8.8vw,2.15rem);line-height:.98}
  .svccard__d{font-size:16px;line-height:1.45;max-width:none}
  .svccard__well{min-height:0}

  .steps{margin-top:28px}
  .step{grid-template-columns:38px 1fr;gap:14px;padding:16px 0}
  .step__k{font-size:1.05rem}
  .step__t{font-size:1.25rem}
  .step__b{font-size:16px;margin-top:6px;max-width:none}

  /* pricing: the tablist collapses to whole cards */
  .price{display:block}
  .price .tiers,.price .detail{display:none}
  .tiercards{display:grid;gap:14px;margin-top:28px}
  .payhead{gap:14px}
  .paytoggle{width:100%;display:grid;grid-template-columns:1fr 1fr}
  .paytoggle button{padding:14px 12px;font-size:15px}

  .qa summary{font-size:1.08rem;gap:14px}
  .qa__a p{font-size:16px;max-width:none}

  .quote--hero{font-size:min(8.4vw,2.2rem);line-height:1.06;max-width:none}
  .quote__a{font-size:16px}

  /* contact: both details become full-width rows, which fixes the measure and
     the 44px target in one move. overflow-wrap:anywhere because the email is
     one 36-character unbreakable token that otherwise forces the grid column
     wider than the screen and gets silently clipped (home-r9.css:706-708). */
  .stack .end{padding-top:clamp(96px,13svh,140px);
    padding-bottom:calc(24px + env(safe-area-inset-bottom))}
  .end__main{gap:22px}
  .big{display:flex;align-items:center;justify-content:space-between;gap:14px;
    width:100%;min-width:0;font-size:min(4.9vw,1.15rem);letter-spacing:-.02em;
    padding:15px 0;border-bottom:1px solid rgba(255,255,255,.28);
    overflow-wrap:anywhere;line-height:1.25}
  .big::after{content:"";flex:none;width:9px;height:9px;
    border-right:2px solid var(--aqua);border-bottom:2px solid var(--aqua);
    transform:rotate(-45deg)}
  .end__foot{display:grid;gap:10px;font-size:13.5px;line-height:1.45}
  .end__nav{gap:16px}
}

/* home-r9.css:716-720 */
@media (max-width:360px){
  .big{font-size:4.4vw;gap:10px}
  .big::after{display:none}
}


/* ==========================================================================
   23  MOTION
   home-r9.css:526-542 verbatim (minus the mangled fragment at line 528 — see
   design-kit.md §6.3; it is a selector list with no declaration block plus a
   @keyframes nothing references).

   TWO EASING CURVES, WITH DISTINCT JOBS:
     cubic-bezier(.16,1,.3,1)  everything — transforms, reveals, layout motion
     cubic-bezier(.4,0,.2,1)   ONLY the persistent bar's colour crossfades

   WHAT NEVER ANIMATES:
     - COUNT-UP NUMBERS ARE BANNED ON THIS SITE (session.md:218). A frozen
       count-up publishes a wrong figure, and on a page carrying prices that is
       a commercial error, not a visual one. Author the true value in markup.
     - Nothing fades in from opacity:0 on scroll. Headings resolve COLOUR
       (.res), cards translate POSITION. Content is always present and
       readable — the design explicitly refuses a hero that renders empty until
       script fires (home-r9.css:3-4, hero.tsx:5-9).
   ========================================================================== */
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
@media (prefers-reduced-motion:no-preference){
  .card{transform:translateY(20px)}
  .in .card{transform:translateY(0)}
  .in .card:nth-child(2){transition-delay:.08s}
  .in .card:nth-child(3){transition-delay:.16s}
  .in .card:nth-child(4){transition-delay:.24s}
  .in .card:nth-child(5){transition-delay:.32s}
  .in .card:nth-child(6){transition-delay:.4s}

  .in .step__r{transform:scaleX(1);transition:transform 1s cubic-bezier(.16,1,.3,1)}
  .in .step:nth-child(2) .step__r{transition-delay:.14s}
  .in .step:nth-child(3) .step__r{transition-delay:.28s}
  .in .step:nth-child(4) .step__r{transition-delay:.42s}

  /* .mock's one live element */
  [data-anim="in"]{animation:pop 4.6s cubic-bezier(.16,1,.3,1) infinite}
  @keyframes pop{0%,12%{transform:translateY(9px) scale(.94)}22%,72%{transform:translateY(0) scale(1)}86%,100%{transform:translateY(9px) scale(.94)}}
  [data-anim="cell"]{animation:cell 4.6s steps(1,end) infinite}
  @keyframes cell{0%,30%{opacity:.35}40%,100%{opacity:1}}

  .row,.svc,.step{transform:translateY(18px);
    transition:transform .8s cubic-bezier(.16,1,.3,1),
               padding-left .45s cubic-bezier(.16,1,.3,1),background .35s ease}
  .in .row,.in .svc,.in .step{transform:translateY(0)}
}


/* ==========================================================================
   24  TOUCH (hover:none)
   home-r9.css:560-580 verbatim, for the patterns this kit includes.

   Hover effects fire on tap and then LATCH until you tap elsewhere. This block
   neutralises every rule that changes position, colour or scale, so a tap
   never leaves a stuck state.

   ANY NEW HOVER EFFECT MUST BE ADDED HERE. That is not optional tidying — it
   is the difference between a working phone page and one covered in stuck
   states.
   ========================================================================== */
@media (hover:none){
  a,button,summary{-webkit-tap-highlight-color:rgba(214,0,107,.16);touch-action:manipulation}
  .burger:hover{background:none;color:inherit}
  .bar nav a:hover::after{transform:scaleX(0)}
  .bar nav a[aria-current]::after{transform:scaleX(1)}
  .hire:hover,.btn:hover,.card:hover,.cards--2 .card:hover{transform:none;box-shadow:none}
  .btn:hover svg,.hire:hover svg{transform:none}
  .card:hover::before{transform:scaleX(0)}
  .card:hover .card__well img,.card:hover .card__well video,
  .svccard:hover .svccard__well img,.svccard:hover .svccard__well video{transform:none}
  .cards--2 .card:hover .card__t{color:inherit}
  .row:hover::after{transform:scaleY(0)}
  .row:hover .row__n,.row:hover .row__m{color:inherit}
  .svc:hover,.qa summary:hover,.tier:hover{padding-left:0}
  .tier:hover{background:none}
  .svccard__l:hover{gap:9px}
  .wpanel__l:hover{gap:9px}
  .big:hover{border-bottom-color:rgba(255,255,255,.3)}
  .menu__nav a:hover span{transform:none;color:inherit}
  .paytoggle button:hover{opacity:.6}
  .paytoggle button[aria-pressed="true"]:hover{opacity:1}
}


/* ##########################################################################
   ##########################################################################
   ##                                                                      ##
   ##   PHASE 2 ADDITIONS — TIER 0 CHROME + LONG-FORM PROSE                ##
   ##                                                                      ##
   ##   Everything below this banner was added by Phase 2 (2026-09-15).    ##
   ##   Everything above it is Phase 1 and is unchanged — not one Phase 1  ##
   ##   declaration was edited or deleted, so the two halves can be        ##
   ##   reconciled with Phase 3's additions by line range alone.           ##
   ##                                                                      ##
   ##   Closes design-kit.md gaps G1, G2, G3, G4, G5, G7, G13.             ##
   ##                                                                      ##
   ##   PROVENANCE RULE IS UNCHANGED: every value is cited to home-r9.css,
   ##   shared.css, kit.css above, or the 2026-08-26 round-1 prototypes
   ##   (project-list.html / project-post.html). The handful of genuinely
   ##   new numbers are marked INVENTED and listed in phase2-notes.md.
   ##
   ##   CONTENTS
   ##     25  cornerfill completion (G7)
   ##     26  header nav — real page links, active state, collapse (G1)
   ##     27  menu overlay — real page links, active state (G1 mobile)
   ##     28  breadcrumb (G4)
   ##     29  page masthead (G3)
   ##     30  .sec — non-sticky inner-page section shell
   ##     31  .prose — long-form article body (G5)
   ##     32  .pagefoot — page-level footer (G2)
   ##     33  .btn--ghost — G13 decision
   ##     34  Phase 2 responsive
   ##     35  Phase 2 touch (hover:none)
   ########################################################################## */


/* ==========================================================================
   25  CORNERFILL COMPLETION  (design-kit.md G7)

   home-r9.css:138-141 defines four cf-- modifiers and chapter-panel.tsx:43
   types the union as 'ink'|'white'|'magenta'|'aqua'. A sequence that opens a
   panel below a navy or paper pane has no modifier to reach for.

   Phase 2 does not itself need these — the inner-page section shell in §30
   overlaps rather than sticks, so no corner ever reveals the body. They are
   added because the gap is real for any Phase 3 page that does build a
   .stack, and because completing the set is two lines with no risk.
   Colours are var(--navy)/var(--paper), same form as the four above.
   ========================================================================== */
.cf--navy{background:var(--navy)}
.cf--paper{background:var(--paper)}


/* ==========================================================================
   26  HEADER NAV — REAL PAGE LINKS  (design-kit.md G1)

   The bar's link treatment already exists in full and has never rendered:
   home-r9.css:89-95 styles `.bar nav a` but site-bar.tsx renders no <nav>
   (design-kit.md §6.3, §12.1). kit.css §04 already carries the container
   (shared.css:46), the underline, and the [aria-current] active state
   (shared.css:52). So the *treatment* is reused wholesale. What Phase 2 adds
   is the three things a real six-link nav needs and an anchor-only bar never
   did: a legible active state, a collapse rule, and a burger that only exists
   below the collapse.

   THE ACCENT-SWAP SYSTEM NEEDS NOTHING. `.bar nav a::after` is already
   `background:var(--bar-acc)` (kit.css:231), so the underline is aqua on
   ink/magenta/navy and magenta on paper/white/aqua with no per-ground rule.
   Verified by rendering all six grounds — see phase2-notes.md.
   ========================================================================== */

/* The underline alone is not enough to mark the current page: every link in
   the row sits at opacity .72 (kit.css:228), so the active one reads as the
   dimmest thing in the bar with a small line under it. 1 is the value
   `.bar nav a:hover` already uses (kit.css:233) — the active page should read
   at least as strongly as a hovered one, not weaker. */
.bar nav a[aria-current]{opacity:1}

/* The burger is the nav BELOW the collapse breakpoint and nothing above it.
   The homepage keeps its burger at every width because the burger IS its only
   nav; an inner page showing six real links does not need both, and showing
   both invites the question of what is inside the second one.
   1080px is home-r9.css:508's existing breakpoint, not a new number. Measured
   reason: at 1080px the six links + logo lockup + CTA pill leave ~40px of
   slack, and below that the row starts eating the lockup. */
.bar .burger{display:none}


/* ==========================================================================
   27  MENU OVERLAY — REAL PAGE LINKS  (design-kit.md G1, mobile half)

   The overlay itself is unchanged (kit.css §05, home-r9.css:77-88). Two
   things change once it carries six real routes instead of five in-page
   anchors.

   TRAP RE-CHECKED, NOT ASSUMED: `.menu` must be a SIBLING of `.bar`, because
   backdrop-filter or transform on an ancestor makes it the containing block
   for position:fixed descendants and traps the overlay in the bar's own box.
   Grepped sites/dcs/styles/ and components/home/: the r9 `.bar` carries
   NEITHER (the only backdrop-filter in the site is the retired pre-r9
   site-header.tsx:31, which this chrome replaces). So the trap is not armed
   here — but the prototypes still compose them as siblings, because the rule
   is about not depending on that staying true.
   ========================================================================== */

/* Six links at clamp(2.1rem,7vw,5.4rem) is ~450px of type at 1080px wide. In
   a grid with align-content:center (kit.css:263) overflow spills equally off
   BOTH ends, so on a short landscape window the first link becomes
   unreachable — there is nothing above the scroll origin to scroll to.
   `safe center` degrades to start-alignment instead. An unsupported value
   invalidates only this declaration, leaving kit.css:263's plain `center`. */
.menu{overflow-y:auto;align-content:safe center}

/* The current page, using the same aqua the hover state already uses
   (kit.css:270) — one colour doing one job, not a second accent. */
.menu__nav a[aria-current] span{color:var(--aqua)}


/* ==========================================================================
   28  BREADCRUMB  (design-kit.md G4)

   DECISION: ADOPT project-post.html:2-5's `.crumb` — every value verbatim —
   WITH THREE ADAPTATIONS. Recorded in full in phase2-notes.md. It was right;
   Phase 1 simply declined to promote a page-local rule without a decision.

   Verbatim from project-post.html:12-15:
     padding clamp(90px,12vh,124px) var(--pad) 0 · 13.5px
     a opacity .6 -> 1 on hover, going aqua · separator opacity .35, margin 0 8px

   ADAPTATION 1 — semantics. Round 1 used bare <a> and <span>. Here it is a
   real <nav aria-label="Breadcrumb"> around an <ol>, and the separator is
   generated by li+li::before rather than authored as a <span>. Same 8px
   margin, same .35 opacity; the separator stops being content a screen reader
   reads out.

   ADAPTATION 2 — the hover colour was wrong on light grounds. Aqua on white
   is ~1.7:1. The accent-swap rule (design-kit.md §1.4) says the accent is
   magenta on paper/white/aqua and aqua on ink/magenta/navy, so the ground
   variants below apply the rule the rest of the design already follows. Round
   1 only ever put a crumb on ink, so this never came up.

   ADAPTATION 3 — the touch target. 13.5px text is a ~16px line box; 13px of
   block padding takes it to ~42px. 13px is the value kit.css:955 already uses
   to lift `.end__nav a` to the 44px floor. In §34.
   ========================================================================== */
.crumb{position:relative;z-index:2;padding:clamp(90px,12vh,124px) var(--pad) 0;font-size:13.5px}
.crumb ol{list-style:none;display:flex;flex-wrap:wrap;align-items:center}
.crumb li{display:flex;align-items:center}
.crumb li+li::before{content:"/";opacity:.35;margin:0 8px}
.crumb a{opacity:.6;transition:opacity .3s ease,color .3s ease}
.crumb a:hover{opacity:1;color:var(--aqua)}
/* project-post.html:68 set this inline as style="opacity:.85" on the last
   crumb. Same value, now attached to the attribute that already marks it. */
.crumb [aria-current]{opacity:.85}
/* accent swap — see ADAPTATION 2. Both forms, because the crumb is USUALLY
   its own band carrying the ground class itself (`.crumb.p--ink`, so that the
   bar's [data-ground] probe reads it) but can also sit inside a grounded
   section. A descendant selector alone silently misses the common case. */
.p--white .crumb a:hover,.p--paper .crumb a:hover,.p--aqua .crumb a:hover,
.crumb.p--white a:hover,.crumb.p--paper a:hover,.crumb.p--aqua a:hover{color:var(--magenta)}


/* ==========================================================================
   29  PAGE MASTHEAD  (design-kit.md G3)

   RECONCILED, NOT REINVENTED. Three page-local answers to this already
   existed and Phase 1 promoted none of them:

     project-list.html:3   .hero override — padding clamp(150px,20vh,220px)
                           var(--pad) clamp(48px,7vh,80px) on ink
     project-list.html:4-6 .credentials — a bordered row of facts under it
     project-post.html:17  .chero__head — padding 20px var(--pad) ... when a
                           breadcrumb has already cleared the bar
     project-post.html:20-24 .facts — the same facts row as a separate white
                           band, with each fact stacked (value over label)
     kit.css:344           .panel--tight — shared.css:79's fourth answer,
                           clamp(140px,18vh,200px) top

   `.mast` takes project-list's paddings, because that is the pair that
   actually rendered and was reviewed. `.panel--tight` is left in place
   untouched rather than deleted — but `.mast` is the named masthead and
   Phase 3 should use it. Flagged for Phase 4 to retire one of them.

   `.mast__meta` folds `.credentials` and `.facts` into ONE component: the
   container is `.credentials` (rule above, flex, wrap), the item is `.facts`
   (stacked value over small-caps label), which is the more legible of the two
   and is the one the small-caps label idiom (design-kit.md §2.3) belongs to.

   h1 here is kit.css:116's INNER-PAGE scale clamp(2.3rem,7vw,6.4rem), not the
   homepage's 8.8rem — a masthead at hero weight out-shouts the homepage
   (design-kit.md §11.2). max-width:17ch is `.stack h2`'s measure (kit.css:135)
   rather than a new number; without it a long service title runs the full
   gutter-to-gutter width and stops reading as a title.
   ========================================================================== */
.mast{position:relative;z-index:1;
  padding:clamp(150px,20vh,220px) var(--pad) clamp(48px,7vh,80px)}
/* project-post.html:17 — when a breadcrumb precedes the masthead it has
   already cleared the fixed bar, so the masthead must NOT clear it again. */
.crumb+.mast{padding-top:20px}
.mast h1{max-width:17ch}
.mast .lead{max-width:56ch}
/* container: project-list.html:4-6 .credentials · item: project-post.html:20-24 .facts */
.mast__meta{margin-top:clamp(28px,4vh,44px);display:flex;flex-wrap:wrap;
  gap:clamp(22px,3vw,48px);padding-top:clamp(20px,3vh,28px);
  border-top:1px solid rgba(255,255,255,.22)}
.mast__meta div{display:grid;gap:3px}
.mast__meta b{font-weight:800;font-size:15.5px;letter-spacing:-.01em}
.mast__meta span{font-size:12px;text-transform:uppercase;letter-spacing:.08em;opacity:.55}
/* the same rule on a light ground — .16 is the bar's own light rule value
   (home-r9.css:50), so the masthead borrows the alpha it already uses there */
.p--white .mast__meta,.p--paper .mast__meta,.p--aqua .mast__meta{border-top-color:rgba(14,14,18,.16)}
/* kit.css:305's action row, given the same distance from the block above it
   as .mast__meta so the two are interchangeable in that slot */
.mast .hero__act{margin-top:clamp(28px,4vh,44px)}


/* ==========================================================================
   30  .sec — NON-STICKY INNER-PAGE SECTION SHELL

   The signature boundary of this design is a panel's rounded top corners
   (--r) revealing the colour of the pane above it. On the homepage that works
   because `.panel` is sticky and `.cornerfill` paints the revealed strip
   (design-kit.md §1.3). An inner page is not a chapter stack, so `.panel` is
   non-sticky here (kit.css:343) — and a non-sticky rounded section reveals
   its PARENT's background through the corners, which is the body's --paper.
   Every boundary on the page would flash paper.

   `.sec` gets the same cut without the sticky machinery: it pulls itself up
   over the section above by exactly --r, so the previous section's own colour
   is what shows through the corners. No cornerfill element, no colour to pass
   in, and therefore none of chapter-panel.tsx:15-31's "the fill is the pane
   ABOVE, not the panel being opened" trap to get wrong.

   The overlap is safe because --r maxes at 44px and every block that can
   precede a .sec has at least 48px of bottom padding to be overlapped into:
   .mast clamp(48px,7vh,80px), .sec itself clamp(56px,8vh,96px).

   Padding is home-r9.css:170's `.worksec` verbatim — design-kit.md §6.2 calls
   `.worksec` "the closest thing to an inner-page section shell that already
   exists", and this is that shell with the ground left to `.p--*`.
   ========================================================================== */
.sec{position:relative;z-index:1;border-radius:var(--r) var(--r) 0 0;
  margin-top:calc(var(--r) * -1);
  padding:clamp(74px,9vh,120px) var(--pad) clamp(56px,8vh,96px)}
.sec:first-child{margin-top:0;border-radius:0}

/* the 74ch measure, as its own class so it can wrap a .qa or a check list
   without .prose's element rules reaching them. 74ch is
   project-post.html:25's `.body` measure. */
.measure{max-width:74ch;margin-inline:auto}

/* `.row`/`.work` (kit.css §12) was written for white and paper grounds only:
   `.row__m` hardcodes #5E5E68 (home-r9.css:322 — design-kit.md §1.1 records
   it as the one non-token grey in the design), which goes muddy on aqua.
   rgba(14,14,18,.66) is `.p--aqua .res`'s own rest colour (kit.css:165), i.e.
   the value this design already uses for muted ink on aqua. */
.p--aqua .row__m{color:rgba(14,14,18,.66)}


/* ==========================================================================
   31  .prose — LONG-FORM ARTICLE BODY  (design-kit.md G5)

   Round 1 got the spine right and stopped: project-post.html:25-28 gives the
   measure, the section rhythm and the paragraph. It has nothing for lists,
   blockquotes, inline links, images in flow, rules or code — and
   /blog/[slug], where "the r9 chapter-panel language has to yield to
   legibility" (session.md:101), depends on all of them.

   Carried verbatim from project-post.html:25-28:
     measure 74ch · h2 clamp(1.7rem,3vw,2.4rem) mt clamp(40px,6vh,60px)
     p 16.5px / 1.7 / opacity .86 · first child margin-top 0

   ONE STRUCTURAL FIX. project-post wrote `.body{max-width:74ch;margin:0 auto;
   padding:... var(--pad)}`. With the design's own border-box reset that
   gutter is INSIDE the 74ch, so the real measure was 74ch minus two --pads —
   about 60ch at 1380px, and about 40ch at the 76px cap. The numbers are
   unchanged here; the gutter moved out to `.sec` and the measure to
   `.measure`, so 74ch is 74ch. Measured both ways — phase2-notes.md.

   EVERY GROUND. .prose is legible on light and dark: rules, bullets, links
   and blockquote accents all swap by the accent rule (aqua on
   ink/magenta/navy, magenta on paper/white/aqua).
   ========================================================================== */
.prose>*+*{margin-top:16px}
.prose>:first-child{margin-top:0}
.prose p{font-size:16.5px;line-height:1.7;opacity:.86}
.prose h2{font-size:clamp(1.7rem,3vw,2.4rem);margin-top:clamp(40px,6vh,60px)}
/* h3: kit.css:121's global h3 is clamp(1.5rem,2.6vw,2.2rem), which collides
   with prose h2's 2.4rem cap — inside a 74ch column the two read as the same
   level. This is `.qa summary`'s type spec (home-r9.css:436) instead, an
   existing pair in the scale that sits a clear step below prose h2. Leading
   1.24 is `.cards--2 .card__t`'s (kit.css:445); the margin is `.filterbar`'s
   clamp(28px,4vh,44px) (kit.css:860). */
.prose h3{font-size:clamp(1.02rem,1.75vw,1.42rem);font-weight:700;letter-spacing:-.022em;
  line-height:1.24;margin-top:clamp(28px,4vh,44px)}
.prose h2+p,.prose h3+p{margin-top:16px}
.prose strong{font-weight:700}

/* --- inline link -------------------------------------------------------
   There is no inline-link treatment anywhere in home-r9.css or shared.css —
   the homepage has no running prose to put one in. Built from parts that do
   exist: the colour is the accent (magenta is "the action colour",
   design-kit.md §1.1, swapping to aqua on dark by §1.4); the underline is
   1.5px, the weight `.svccard__l`, `.wpanel__l` and `.btn--ghost` all use;
   the resting alpha is .5, `.wpanel__l`'s own underline alpha
   (home-r9.css:305). No new numbers. */
.prose a{color:var(--magenta);border-bottom:1.5px solid rgba(214,0,107,.5);
  transition:border-color .3s ease,color .3s ease}
.prose a:hover{border-bottom-color:var(--magenta)}
.p--ink .prose a,.p--navy .prose a,.p--magenta .prose a{
  color:var(--aqua);border-bottom-color:rgba(0,210,216,.5)}
.p--ink .prose a:hover,.p--navy .prose a:hover,.p--magenta .prose a:hover{border-bottom-color:var(--aqua)}

/* --- lists -------------------------------------------------------------
   gap 12px is `.detail__l`'s (kit.css:743); the 62ch measure is `.qa__a p`'s
   (kit.css:799) — a list wants a shorter line than running prose; leading
   1.55 is `.qa__a p`'s. The 28px indent is `.detail__l`'s own optical indent
   (16px icon + 12px gap), so a bulleted list and a check list hang on the
   same edge.
   The bullet is a 6px square: 6px is `.mock__live i`'s dot size, and square
   rather than round because circles are reserved for icon affordances in this
   design (design-kit.md §4) — `.cards--2 .card__well{border-radius:0}` is the
   precedent for a deliberately squared-off small shape. INVENTED: the .62em
   vertical offset, which is optical and has no source. */
.prose ul,.prose ol{display:grid;gap:12px;list-style:none;max-width:62ch;
  margin-top:clamp(28px,4vh,44px)}
.prose li{font-size:16.5px;line-height:1.55;opacity:.86;padding-left:28px;position:relative}
.prose ul li::before{content:"";position:absolute;left:0;top:.62em;
  width:6px;height:6px;background:var(--magenta)}
.p--ink .prose ul li::before,.p--navy .prose ul li::before,
.p--magenta .prose ul li::before{background:var(--aqua)}
/* ordered: the design's number idiom is `.step__k` — weight 800, in the
   accent (home-r9.css:380). Same weight and colour, at running-text size
   (15px, `.quote__a`/`.svccard__l`) instead of `.step__k`'s display size. */
.prose ol{counter-reset:pr}
.prose ol li{counter-increment:pr}
.prose ol li::before{content:counter(pr) ".";position:absolute;left:0;top:0;
  font-weight:800;font-size:15px;color:var(--magenta);line-height:1.8}
.p--ink .prose ol li::before,.p--navy .prose ol li::before,
.p--magenta .prose ol li::before{color:var(--aqua)}

/* --- blockquote --------------------------------------------------------
   `.quote` (kit.css:812) is clamp(1.6rem,3.6vw,2.6rem) — 41.6px inside a
   629px measure is ~15 characters a line, so the homepage's testimonial size
   cannot sit in running prose. This is `.cards--2 .card__t`'s spec instead
   (home-r9.css:182) — 600 weight, -.02em, leading 1.24 — which is an existing
   pair and reads exactly like a pull quote at this measure.
   The 2px accent rule is `.card::before`/`.big`'s weight; 22px is the
   design's recurring short gap (`.lead`, `.detail__l`, `.wpanel__r` margins).
   The attribution is `.quote__a` verbatim: 15px / 600 / ls .03em / op .66. */
.prose blockquote{margin-top:clamp(28px,4vh,44px);padding-left:22px;
  border-left:2px solid var(--magenta);
  font-weight:600;font-size:clamp(1.12rem,1.62vw,1.45rem);
  letter-spacing:-.02em;line-height:1.24}
.p--ink .prose blockquote,.p--navy .prose blockquote,
.p--magenta .prose blockquote{border-left-color:var(--aqua)}
.prose blockquote p{font-size:inherit;line-height:inherit;opacity:1;margin-top:0}
.prose blockquote p+p{margin-top:12px}
.prose blockquote cite{display:block;font-style:normal;margin-top:14px;
  font-size:15px;font-weight:600;letter-spacing:.03em;opacity:.66}

/* --- image in flow -----------------------------------------------------
   18px radius is `.card`'s (home-r9.css:215); the navy backdrop is
   `.card__well`'s (home-r9.css:224), so an image that has not loaded shows
   the same ground a card well does rather than a white hole. The caption is
   `.card__s` verbatim: 13.5px / 1.4 / opacity .72.
   HONESTY: a figure whose media does not exist takes `.slot` (kit.css §10),
   never a stand-in — the .slot__well rule below is the positioning context
   .slot needs, since .slot is position:absolute;inset:0. */
.prose figure{margin-top:clamp(28px,4vh,44px)}
.prose figure img,.prose figure video{width:100%;border-radius:18px;background:var(--navy)}
.prose figure .slot__well{position:relative;aspect-ratio:16/10;border-radius:18px;
  overflow:hidden;background:var(--navy)}
.prose figcaption{margin-top:12px;font-size:13.5px;line-height:1.4;opacity:.72}

/* --- rule --------------------------------------------------------------
   .14 is `.work`/`.row`'s light rule (home-r9.css:313); .22 is `.qa`'s dark
   rule (home-r9.css:432). Same distance as a new h2, because that is what it
   is standing in for. */
.prose hr{border:0;height:1px;background:rgba(14,14,18,.14);
  margin-top:clamp(40px,6vh,60px)}
.p--ink .prose hr,.p--navy .prose hr,.p--magenta .prose hr{background:rgba(255,255,255,.22)}

/* --- code --------------------------------------------------------------
   !!! TRAP — READ BEFORE USING !!!
   This is the ONLY monospaced face anywhere in this design, and a mono face
   gives a thousands comma a full digit advance exactly as tabular-nums does:
   GBP 1,995 renders as "1 , 995". It INHERITS. So never wrap a price, or any
   comma'd figure, in <code>, and never widen this selector — put a price in
   running prose or in `.tier__f`/`.tcard__f`, which deliberately carry no
   numeric font styling (pricing.tsx:21-25, design-kit.md §9.1).

   INVENTED: the font stack, .92em, and both paddings — there is no mono
   anywhere in home-r9.css or shared.css to copy. Everything else is reused:
   the .06 tint is `.paytoggle`'s track (kit.css:695), 3px is the design's
   smallest radius (.mock__bar / :focus-visible), 18px is `.card`'s. */
.prose code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:.92em;background:rgba(14,14,18,.06);border-radius:3px;padding:2px 6px}
.p--ink .prose code,.p--navy .prose code,.p--magenta .prose code{background:rgba(255,255,255,.12)}
.prose pre{background:var(--ink);color:#fff;border-radius:18px;padding:20px 22px;
  overflow-x:auto;margin-top:clamp(28px,4vh,44px)}
/* FOUND BY RENDERING: an ink <pre> on an ink section is invisible as a block —
   the code just floats in the panel with no container. --navy against --ink is
   a pairing the design already relies on (`.card__well` and `.mock` both sit
   navy inside otherwise dark panels), so the block reads without a new colour.
   A navy section keeps the base --ink, which is distinguishable from it. */
.p--ink .prose pre,.p--magenta .prose pre{background:var(--navy)}
.prose pre code{background:none;padding:0;font-size:14px;line-height:1.6}


/* ==========================================================================
   32  .pagefoot — PAGE-LEVEL FOOTER  (design-kit.md G2)

   `.end` is the homepage's closing CHAPTER, not a footer: align-content
   stretch across a full sticky viewport with clamp(170px,22vh,260px) of top
   padding (home-r9.css:454-455). Dropped at the bottom of a service page it
   reads as a sixth section rather than as the end of the document.

   `.pagefoot` keeps the closing MOVE and loses the chapter: the same navy
   ground, the same oversized `.big` contact links, the same `.end__foot` rule
   and microcopy row — at project-list.html:13's shortened padding,
   clamp(90px,12vh,140px) top, which is round 1's own answer to this and the
   one that rendered.

   It adds the one thing a page-level footer has that a closing chapter does
   not: the link map. Per decision D2 (session.md:137-141) the 8 location
   pages live HERE and not in the primary nav — they are worth keeping and
   worth finding, and they must not pull the brand back toward local trades by
   sitting in the top-level nav.

   Every value below is reused: the column gap is `.price`'s
   clamp(22px,3.4vw,58px) (home-r9.css:393); the rule above the map and the
   distance to it are `.end__foot`'s own (home-r9.css:460); the link size,
   opacity and aqua hover are `.menu__foot`'s 15px / .76 / aqua
   (home-r9.css:86-88); the list gap is `.detail__l`'s 12px.
   ========================================================================== */
.pagefoot{position:relative;z-index:1;border-radius:var(--r) var(--r) 0 0;
  margin-top:calc(var(--r) * -1);
  padding:clamp(90px,12vh,140px) var(--pad) clamp(40px,6vh,64px)}
.pagefoot .end__main{gap:clamp(20px,3vw,34px)}
.pagefoot h2{max-width:14ch}

.footmap{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(22px,3.4vw,58px);
  margin-top:clamp(56px,8vh,96px);padding-top:clamp(28px,4vh,48px);
  border-top:1px solid rgba(255,255,255,.22)}
.footmap .eyeless{margin-bottom:0}
.footmap ul{list-style:none;display:grid;gap:12px;margin-top:16px}
/* overflow-wrap:anywhere is NOT tidying. The business email is one
   36-character unbreakable token; in a grid track narrower than it, the item
   overflows its own minmax(0,1fr) track and pushes the document wider than
   the viewport, which html{overflow-x:clip} then silently CLIPS — no
   scrollbar, no error, just a truncated address. Measured at 390px before
   this line: documentElement.scrollWidth 453 against innerWidth 390, from
   four footer links. home-r9.css:706-708 records the identical fix for `.big`
   for the identical reason. */
.footmap a{font-size:15px;opacity:.76;overflow-wrap:anywhere;
  transition:color .3s ease,opacity .3s ease}
.footmap a:hover{opacity:1;color:var(--aqua)}
.footmap a[aria-current]{opacity:1;color:var(--aqua)}
/* the footer's own foot row keeps home-r9.css:460's rule, but it now sits
   under the map rather than under the CTA, so the distance is the map's. */
.pagefoot .end__foot{margin-top:clamp(28px,4vh,48px)}


/* ==========================================================================
   33  .btn--ghost — G13 DECISION

   CONFIRMED AS WRITTEN. kit.css §06 resolved home-r9.css:128 (light ground,
   ink border) against shared.css:67 (dark ground, white border) by grounding
   the selector rather than picking a winner, and flagged it for Phase 2.

   Checked every ground the kit can produce rather than the two in the
   conflict: .p--ink / .p--navy / .p--magenta take the white-bordered rule;
   .p--white, .p--paper and .p--aqua fall through to the base ink-bordered
   rule, which is correct on all three — aqua is a LIGHT ground (kit.css:196
   gives it --bar-fg:var(--ink)), so an ink border is right there too. The set
   is complete and no sixth case exists. Rendered on all six — phase2-notes.md.

   The one thing that needed doing: the new chrome had to carry a `.p--*`
   class for the selector to reach it. `.mast` and `.pagefoot` are shells with
   no ground of their own precisely so they compose with `.p--*` rather than
   hardcoding a background, which round 1 did inline
   (project-post.html:153 style="background:var(--navy)"). No CSS change.
   ========================================================================== */


/* ==========================================================================
   34  PHASE 2 RESPONSIVE
   ========================================================================== */

/* home-r9.css:508's existing breakpoint. Above it, six links; below it, the
   burger and the overlay. NOTE FOR PHASE 4: kit.css:931 already hides
   `.bar nav` at 900px for the same reason. This rule supersedes it and the
   two should be reconciled into one — left in place rather than edited so
   the Phase 1 half of this file stays untouched. */
@media (max-width:1080px){
  .bar nav{display:none}
  .bar .burger{display:grid}
}

@media (max-width:900px){
  /* 84px is kit.css:973's own "clear the mobile bar" number, used there for
     `.wpanel__ix`. The crumb is the first thing under the bar on every inner
     page, so it inherits the same clearance. */
  .crumb{padding-top:calc(84px + env(safe-area-inset-top))}
  /* 44px touch floor. kit.css:955 reaches it for `.end__nav a` with
     padding:13px 0, but that was calibrated against 15px text; at the crumb's
     13.5px the same padding measures 41px, not 44. Asserting the doctrine's
     own number directly is both exact and self-documenting. */
  .crumb a{display:inline-flex;align-items:center;min-height:44px}
  .crumb{padding-bottom:0}

  /* the masthead loses its desktop clearance; 96px is home-r9.css:512's
     mobile `.hero` padding-top, the established floor under this bar */
  .mast{padding-top:clamp(96px,13vh,140px)}
  .mast h1{max-width:none}
  .mast .lead{max-width:none}
  .mast__meta{gap:22px}

  /* prose already sits above the 16px floor at 16.5px, so the only mobile
     change is the measure, which stops binding on its own below ~760px */
  .prose blockquote{padding-left:18px}
  .prose pre{padding:16px 18px}

  .footmap{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
  .footmap a{display:inline-block;padding:8px 0}
  .pagefoot{padding-bottom:calc(40px + env(safe-area-inset-bottom))}
  /* kit.css:1013-1019 turns .big into a full-width row with a chevron inside
     `.stack .end`; the page footer needs the same treatment, so the selector
     is widened here rather than the Phase 1 rule being edited. */
  .pagefoot .big{display:flex;align-items:center;justify-content:space-between;gap:14px;
    width:100%;min-width:0;font-size:min(4.9vw,1.15rem);letter-spacing:-.02em;
    padding:15px 0;border-bottom:1px solid rgba(255,255,255,.28);
    overflow-wrap:anywhere;line-height:1.25}
  .pagefoot .big::after{content:"";flex:none;width:9px;height:9px;
    border-right:2px solid var(--aqua);border-bottom:2px solid var(--aqua);
    transform:rotate(-45deg)}
  .pagefoot .end__foot{display:grid;gap:10px;font-size:13.5px;line-height:1.45}
}

@media (max-width:360px){
  .pagefoot .big{font-size:4.4vw;gap:10px}
  .pagefoot .big::after{display:none}
}


/* ==========================================================================
   35  PHASE 2 TOUCH (hover:none)
   Every hover effect added above, neutralised. kit.css §24's rule — "any new
   hover effect must be added here" — is not optional tidying: on touch a
   hover fires on tap and LATCHES until you tap elsewhere, so a tapped
   breadcrumb or footer link stays lit for the rest of the visit.
   ========================================================================== */
@media (hover:none){
  .crumb a:hover{opacity:.6;color:inherit}
  .crumb [aria-current]{opacity:.85}
  .prose a:hover{border-bottom-color:rgba(214,0,107,.5)}
  .p--ink .prose a:hover,.p--navy .prose a:hover,
  .p--magenta .prose a:hover{border-bottom-color:rgba(0,210,216,.5)}
  .footmap a:hover{opacity:.76;color:inherit}
  .footmap a[aria-current]{opacity:1;color:var(--aqua)}
  /* kit.css:1108 neutralises .menu__nav a:hover span to color:inherit. The
     current page's own link is the one most likely to be tapped, so it has to
     be re-asserted after that rule or it goes plain on tap. */
  .menu__nav a[aria-current] span{color:var(--aqua)}
}
