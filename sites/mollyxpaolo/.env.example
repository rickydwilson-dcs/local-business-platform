# mollyxpaolo — runtime env vars. Values are set in the Vercel dashboard, never committed.

# Guest passcode (compared trimmed and case-insensitively, so phone auto-capitalisation is harmless).
MXP_PASSCODE=
# Admin password for /admin (compared exactly). Must differ from the passcode.
MXP_ADMIN_PASSWORD=
# HMAC key for cookies and share links. Long and random, e.g. `openssl rand -base64 48`.
MXP_LINK_SECRET=
# Bump (1 → 2) to revoke every share link and every visitor's cookie at once.
MXP_LINK_VERSION=1

# Media: the public bucket base INCLUDING the path token, with a trailing slash.
MXP_MEDIA_BASE=https://pub-xxxxxxxx.r2.dev/<pathToken>/

# Curation state (S3 API, bucket-scoped token). MXP_STATE_KEY is the random folder the state
# JSON lives under — a second secret, distinct from the image path token.
R2_ACCOUNT_ID=
MXP_R2_BUCKET=mollyxpaolo
MXP_R2_ACCESS_KEY_ID=
MXP_R2_SECRET_ACCESS_KEY=
MXP_STATE_KEY=
