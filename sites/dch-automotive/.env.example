# Site
# Using the Vercel-assigned URL for now — not cutting over the live
# dchautomotive.co.uk domain yet. Update once the Vercel deployment URL is known.
NEXT_PUBLIC_SITE_URL=https://dch.vercel.app

# Image Storage (Cloudflare R2)
# SHARED across LBP sites — same bucket/public URL as every other site.
# This site's images live under the dch-automotive/ key prefix within it.
# Copy the value from another site's (e.g. colossus-scaffolding's) Vercel env settings.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-a159d5c51e44442897e06986a53dda1d.r2.dev
R2_BUCKET_NAME=local-business-platform

# Feature Flags (all false by default — enable per-site in Vercel)
NEXT_PUBLIC_FEATURE_CONSENT_BANNER=false
NEXT_PUBLIC_FEATURE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FEATURE_GA4_ENABLED=false
NEXT_PUBLIC_FEATURE_FACEBOOK_PIXEL=false
NEXT_PUBLIC_FEATURE_GOOGLE_ADS=false
FEATURE_ANALYTICS_ENABLED=false
FEATURE_CONSENT_BANNER=false
FEATURE_GA4_ENABLED=false
FEATURE_SERVER_TRACKING=false
FEATURE_FACEBOOK_PIXEL=false
FEATURE_GOOGLE_ADS=false

# Analytics (set when enabling features above)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# NewRelic (set when enabling monitoring)
# SHARED across LBP sites — same license key as colossus-scaffolding /
# dj-fox-electrical. Copy the value from either project's Vercel env settings.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=dch-automotive
NEW_RELIC_LOG=stdout
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Supabase (required for rate limiting on contact form)
# SHARED across LBP sites — same Supabase project as every other site.
# SUPABASE_URL is not secret; SUPABASE_SERVICE_KEY is — copy both from
# colossus-scaffolding's or dj-fox-electrical's Vercel env settings.
SUPABASE_URL=https://nhpgaluxxiyaxidctqyx.supabase.co
SUPABASE_SERVICE_KEY=

# Email (Resend — required for contact form)
# SHARED across LBP sites — same Resend API key as dj-fox-electrical.
# Copy the value from that project's Vercel env settings.
# (RESEND_FROM_EMAIL/RESEND_TO_EMAIL are not read by the code — the contact
# handler pulls businessName/businessEmail/fromEmail from site.config.ts.)
RESEND_API_KEY=

# CSRF Protection (required for contact forms)
# UNIQUE to this site — do not reuse another site's value.
# Generate with: openssl rand -hex 32
CSRF_SECRET=
