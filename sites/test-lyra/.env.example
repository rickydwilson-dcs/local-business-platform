# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.co.uk

# Feature Flags (all false by default — enable per-site in Vercel)
NEXT_PUBLIC_FEATURE_CONSENT_BANNER=false
NEXT_PUBLIC_FEATURE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FEATURE_GA4_ENABLED=false
NEXT_PUBLIC_FEATURE_FACEBOOK_PIXEL=false
NEXT_PUBLIC_FEATURE_GOOGLE_ADS=false
FEATURE_ANALYTICS_ENABLED=false
FEATURE_CONSENT_BANNER=false
FEATURE_GA4_ENABLED=false
FEATURE_SERVER_TRACKING=false
FEATURE_FACEBOOK_PIXEL=false
FEATURE_GOOGLE_ADS=false

# Analytics (set when enabling features above)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# NewRelic (set when enabling monitoring)
NEW_RELIC_LICENSE_KEY=

# Supabase (required for rate limiting on contact form)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email (Resend — required for contact form)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.co.uk
RESEND_TO_EMAIL=info@yourdomain.co.uk
