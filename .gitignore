# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*

# Testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
**/test-results/
**/playwright-report/
**/newrelic_agent.log
*.lcov

# Next.js (multiple sites)
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Production
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env*
!.env.example
!.env.local.example

# Vercel - ignore entirely (CI creates .vercel dynamically)
.vercel

# Turborepo
.turbo

# OS
.DS_Store
*.pem
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Images - These go to Cloudflare R2, not Git
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp
**/*.gif
# Keep the directory structure examples
!assets/.gitkeep
!assets/README.md
# Playwright snapshot baselines are committed (not R2 assets)
!sites/**/e2e/**/*.png
# DCH Automotive: R2 not yet configured for this site — logo, Stitch-generated
# imagery, and Viezu partner assets are committed directly until it is
!sites/dch-automotive/public/logo/**
!sites/dch-automotive/public/stitch-images/**
# NPRacing favicons — tiny, static, simpler as committed files than routing
# through R2 for a file-convention icon (app/icon.png / app/apple-icon.png)
!sites/npracing-v1/app/icon.png
!sites/npracing-v1/app/apple-icon.png
!sites/npracing-v3/app/icon.png
!sites/npracing-v3/app/apple-icon.png
!sites/dch-automotive/public/viezu/**

# Temporary files
tmp/
temp/
*.tmp

# Client intake folders (before processing)
client-images/

# Lock files (keep pnpm-lock.yaml)
package-lock.json
yarn.lock

# Output folder - temporary/generated files only
output/generated-images/
output/batch-*.json*

# Git worktrees for parallel YOLO sessions
.claude/worktrees/

# Claude Code scheduled-task lock — process-local, churns every session
.claude/scheduled_tasks.lock
