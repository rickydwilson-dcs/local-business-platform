{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_KEY",
        "RESEND_API_KEY",
        "FEATURE_GA4_ENABLED",
        "FEATURE_FACEBOOK_PIXEL",
        "FEATURE_GOOGLE_ADS",
        "FEATURE_ANALYTICS_ENABLED",
        "FEATURE_SERVER_TRACKING",
        "CSRF_SECRET",
        "BUSINESS_NAME",
        "BUSINESS_EMAIL",
        "R2_BUCKET_NAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:smoke": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:ui": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
