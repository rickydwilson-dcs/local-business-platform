{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "FEATURE_CONSENT_BANNER",
        "FEATURE_GA4_ENABLED",
        "FEATURE_FACEBOOK_PIXEL",
        "FEATURE_GOOGLE_ADS",
        "FEATURE_ANALYTICS_ENABLED",
        "FEATURE_SERVER_TRACKING",
        "CSRF_SECRET",
        "BUSINESS_NAME",
        "BUSINESS_EMAIL",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "GA4_API_SECRET",
        "FACEBOOK_ACCESS_TOKEN",
        "NEW_RELIC_LICENSE_KEY",
        "NEW_RELIC_APP_NAME",
        "NEW_RELIC_LOG",
        "NEW_RELIC_DISTRIBUTED_TRACING_ENABLED",
        "NEW_RELIC_NO_CONFIG_FILE",
        "VERCEL_URL",
        "VERCEL_ENV",
        "NEXT_PUBLIC_FEATURE_CONSENT_BANNER",
        "NEXT_PUBLIC_FEATURE_ANALYTICS_ENABLED",
        "NEXT_PUBLIC_FEATURE_GA4_ENABLED",
        "NEXT_PUBLIC_FEATURE_FACEBOOK_PIXEL",
        "NEXT_PUBLIC_FEATURE_GOOGLE_ADS",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_FACEBOOK_PIXEL_ID",
        "NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID",
        "NEXT_PUBLIC_R2_PUBLIC_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:smoke": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:ui": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
